import WaringLinear.StationaryTwists
import WaringLinear.ProductConductor
import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-! # Stable Fourier phases in the odd powers of a principal maximal ideal -/
noncomputable section
namespace WaringLinear
open Polynomial IsLocalRing
open scoped Classical BigOperators
variable {R : Type*} [CommRing R] [IsDomain R] [IsLocalRing R]

/-- A residue-zero element of a conductor quotient lifts to a nonunit in R.
When the maximal ideal is generated by π, its reduction is a multiple of π. -/
theorem quotient_residue_one_digit (I : Ideal R) [IsLocalRing (R ⧸ I)] (π : R)
    (hπ : maximalIdeal R=Ideal.span {π}) (x : R ⧸ I) (hx : residue _ x=0) :
    Ideal.Quotient.mk I π∣x := by
  obtain ⟨a,rfl⟩ := Ideal.Quotient.mk_surjective x
  have hn : ¬IsUnit a := fun hu => (residue_ne_zero_iff_isUnit _).2 (hu.map (Ideal.Quotient.mk I)) hx
  have ha : a∈maximalIdeal R := mem_nonunits_iff.mpr hn
  rw [hπ,Ideal.mem_span_singleton] at ha
  obtain ⟨b,hb⟩ := ha
  exact ⟨Ideal.Quotient.mk I b,by rw [hb,map_mul]⟩

theorem nonzero_conductor_factor (c d : R) (hc : c≠0) (hd : ¬IsUnit d) :
    Ideal.Quotient.mk (Ideal.span {c*d}) c≠0 := by
  intro hz
  obtain ⟨x,hx⟩ := Ideal.mem_span_singleton.mp ((Ideal.Quotient.eq_zero_iff_mem).1 hz)
  have e : 1=d*x := mul_left_cancel₀ hc (by simpa only [mul_one,mul_assoc] using hx)
  exact hd (isUnit_of_dvd_one ⟨x,e⟩)

/-- At every odd exponent 2r+1 with r≥1 the quadratic multiplier is constant
over the dual residue class of a simple branch, even in ramified quotients. -/
theorem uniformizer_odd_fourier_branch (π : R) (hπ₀ : π≠0) (hπ₁ : ¬IsUnit π)
    (hπ : maximalIdeal R=Ideal.span {π}) (r : ℕ) (hr : 1≤r)
    [IsLocalRing (R ⧸ Ideal.span {π^(r+1)*π^r})]
    [Fintype (R ⧸ Ideal.span {π^(r+1)*π^r})]
    (ψ : AddChar (R ⧸ Ideal.span {π^(r+1)*π^r}) ℂ) (prim : ψ.IsPrimitive)
    (f : (R ⧸ Ideal.span {π^(r+1)*π^r})[X]) (y b : R ⧸ Ideal.span {π^(r+1)*π^r})
    (hder : IsUnit (f.derivative.derivative.eval y)) :
    let phase := oddGaussPhase ψ ((hasseDeriv 2 f).eval y) (Ideal.Quotient.mk _ (π^r))
    let S := Finset.univ.filter (fun x => residue _ x=residue _ y)
    let sum := ∑ x∈S, ψ (f.eval x-b*x)
    (residue _ b≠residue _ (f.derivative.eval y) → sum=0) ∧
    (residue _ b=residue _ (f.derivative.eval y) →
      ∃ a, residue _ a=residue _ y ∧ f.derivative.eval a=b ∧ ‖phase‖=1 ∧
        sum=(Real.sqrt (Fintype.card (R ⧸ Ideal.span {π^(r+1)*π^r})):ℂ)*ψ (f.eval a-b*a)*phase) := by
  let I : Ideal R := Ideal.span {π^(r+1)*π^r}
  let ρ := Ideal.Quotient.mk I
  have dc : π^r∣π^(r+1) := pow_dvd_pow _ (by omega)
  have cd : π^(r+1)∣(π^r)^2 := by
    rw [←pow_mul];exact pow_dvd_pow _ (by omega)
  obtain ⟨hc,hd,ha,hb⟩ := odd_conductor_conditions (π^(r+1)) (π^r)
    (pow_ne_zero _ hπ₀) (pow_ne_zero _ hπ₀) dc cd
  have hn : ¬IsUnit (π^r) := fun hu => hπ₁ (isUnit_of_dvd_unit (dvd_pow_self π (by omega)) hu)
  have hzero : (ρ (π^r))^2*ρ π=0 := by
    rw [←map_pow,←map_mul]
    apply (Ideal.Quotient.eq_zero_iff_mem).2
    have he : (π^r)^2*π=π^(r+1)*π^r := by rw [pow_succ π r,pow_two];ring
    rw [he]
    exact Ideal.subset_span (Set.mem_singleton _)
  apply odd_fourier_branch ψ prim f (ρ (π^(r+1))) (ρ (π^r)) y b hc hd
    (nonzero_conductor_factor _ _ (pow_ne_zero _ hπ₀) hn) ha hb _ hder
  intro x hx
  obtain ⟨u,hu⟩ := quotient_residue_one_digit I π hπ x hx
  rw [hu,←mul_assoc,hzero,zero_mul]

#print axioms uniformizer_odd_fourier_branch
end WaringLinear
