import WaringLinear.ConductorMomentStep
import WaringLinear.TraceFibres
import WaringSiegel.WSL2TraceMixedReduction

/-! # Arithmetic specialization of a marked conductor moment step -/
noncomputable section
open MeasureTheory WaringSiegel
open scoped BigOperators Classical NumberField
namespace WaringLinear
variable {K : Type*} [Field K] [NumberField K]

/-- Real norm of the principal ideal generated by a retained mark. -/
abbrev rootNorm (a : 𝓞 K) : ℝ := Ideal.absNorm (Ideal.span {a})

private theorem rootNorm_pos (a : 𝓞 K) (ha : a ≠ 0) : 0 < rootNorm a := by
  change 0 < ((Ideal.absNorm (Ideal.span {a})) : ℝ)
  exact_mod_cast Ideal.absNorm_pos_iff_mem_nonZeroDivisors.mpr (show Ideal.span {a} ∈ nonZeroDivisors _ by simpa using ha)

/-- Finite sum over the actual multiplication kernel, with the inherited
normalized counting convention. -/
noncomputable def traceFibreMass (a : 𝓞 K) (ha : a ≠ 0) (k : ℕ)
    (f : ArchimedeanTraceTorus K → ℝ) (x : ArchimedeanTraceTorus K) : ℝ := by
  classical
  letI := traceTorusMul_kernel_finite_type (a^k) (pow_ne_zero _ ha)
  letI := Fintype.ofFinite (traceTorusMul (a^k)).ker
  exact ∑ t : (traceTorusMul (a^k)).ker,f (x+t.1)

/-- A finite weighted k-th-power trace Fourier series. -/
abbrev rootSum {α : Type*} [Fintype α] {k : ℕ} (f : (α → 𝓞 K) × (α → ℂ)) :=
  traceWeylSum k f.1 f.2

/-- Number-field stage with genuine monomial Fourier sums, normalized trace
Haar measure, multiplication fibres of exact arithmetic cardinality, and
no assumptions about the cover maps or integrability of the sums. The
remaining inputs are the mark partition, exceptional divisor alternative,
sampled upper tail and prior-order moments. -/
theorem trace_conductor_moment_step {ι κ α : Type*} [Fintype ι] [Fintype κ] [Fintype α]
    (k : ℕ) (marks : ι → 𝓞 K) (badMarks : κ → 𝓞 K)
    (hm : ∀ i,marks i≠0) (hd : ∀ j,badMarks j≠0)
    (parent : (α → 𝓞 K) × (α → ℂ))
    (short coprime : ι → (α → 𝓞 K) × (α → ℂ))
    (exceptional : κ → (α → 𝓞 K) × (α → ℂ))
    (X p h z θ D E A : ℝ)
    (L P B C D₀ Z : ℝ)
    (hX : 1≤X) (hp : 1≤p) (hh : 0<h) (hhp : h<p+2)
    (hD : 0≤D) (hL : 0≤L) (hP : 0≤P) (hB : 0≤B) (hC : 0≤C) (hD₀ : 0≤D₀)
    (hmass : (∑i,(rootNorm (marks i))⁻¹)≤1)
    (hsize : ∀ i,X^θ≤rootNorm (marks i))
    (hparent : ∀ x,rootSum (k:=k) parent x=∑ i,rootSum (k:=k) (short i) (traceTorusMul ((marks i)^k) x))
    (hbad : ∀ x, (∃ i,2*‖rootSum (k:=k) (coprime i) x‖<‖rootSum (k:=k) parent x‖) → ∃ j,‖rootSum (k:=k) parent x‖≤D₀*‖rootSum (k:=k) (exceptional j) (traceTorusMul ((badMarks j)^k) x)‖)
    (hfibre : ∀ i x, traceFibreMass (marks i) (hm i) k (
      {u : ArchimedeanTraceTorus K | X^(1-z)≤2*‖rootSum (k:=k) (coprime i) u‖}.indicator (fun u => ‖rootSum (k:=k) (coprime i) u‖^2)) x≤B*X^2)
    (hlow : (∫x,‖rootSum (k:=k) parent x‖^h ∂traceHaar)≤L*X^(h-(k:ℝ)+E))
    (hshort : ∀ i,(∫x,‖rootSum (k:=k) (short i) x‖^p ∂traceHaar)≤C*(X/rootNorm (marks i))^(p-(k:ℝ)+D))
    (hexcept : ∀ j,(∫x,‖rootSum (k:=k) (exceptional j) x‖^(p+2) ∂traceHaar)≤P*(X/rootNorm (badMarks j))^(p+2-(k:ℝ)+A))
    (hZ : (∑j,((rootNorm (badMarks j))^(p+2-(k:ℝ)+A))⁻¹)≤Z)
    (hAh : E-(p+2-h)*z≤A) (hAD : (1-θ)*D≤A) :
    (∫x,‖rootSum (k:=k) parent x‖^(p+2) ∂traceHaar) ≤ (L+4*B*C+D₀^(p+2)*(P*Z))*X^(p+2-(k:ℝ)+A) := by
  classical
  let π (i : ι) := traceTorusMul ((marks i)^k)
  let ψ (j : κ) := traceTorusMul ((badMarks j)^k)
  letI kerFinite (i : ι) := traceTorusMul_kernel_finite_type ((marks i)^k) (pow_ne_zero _ (hm i))
  letI kerFintype (i : ι) := Fintype.ofFinite (π i).ker
  have hcard (i : ι) : (Fintype.card (π i).ker : ℝ)=(rootNorm (marks i))^(k:ℝ) := by
    rw [Real.rpow_natCast]
    exact_mod_cast (Nat.card_eq_fintype_card.symm.trans (trace_pow_kernel_card (marks i) (hm i) k))
  exact conductor_fourier_moment_step traceHaar π ψ
    (fun i => traceTorusMul_measurePreserving _ (pow_ne_zero _ (hm i)))
    (fun j => traceTorusMul_measurePreserving _ (pow_ne_zero _ (hd j)))
    (fun i => traceTorusMul_continuous _) (fun j => traceTorusMul_continuous _)
    (rootSum (k:=k) parent) (fun i => rootSum (k:=k) (short i))
    (fun i => rootSum (k:=k) (coprime i)) (fun j => rootSum (k:=k) (exceptional j))
    (traceWeylSum_continuous ..) (fun i => traceWeylSum_continuous ..)
    (fun i => traceWeylSum_continuous ..) (fun j => traceWeylSum_continuous ..)
    (fun i => rootNorm (marks i)) (fun j => rootNorm (badMarks j))
    X p k h z θ D E A L P B C D₀ Z
    hX hp hh hhp hD hL hP hB hC hD₀ (fun i => rootNorm_pos _ (hm i))
    (fun j => rootNorm_pos _ (hd j)) hmass hsize hcard hparent hbad hfibre hlow hshort hexcept hZ hAh hAD

#print axioms trace_conductor_moment_step
end WaringLinear
