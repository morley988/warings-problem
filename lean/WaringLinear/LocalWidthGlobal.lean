import WaringLinear.AllMarkedField
import WaringSiegel.WSL4ArchLocalTuples

/-! # Primitive local representation and the field linear theorem -/
noncomputable section
open WaringSiegel WaringSiegel.WSL2 WaringSiegel.WSL4 WaringEnvelope
open scoped NumberField BigOperators
namespace WaringLinear
variable {K : Type*} [Field K] [NumberField K]

/-- A uniform primitive width bound for the actual completed integer rings.
Eligibility is tested in the additive subgroup generated by the local powers. -/
def PrimitiveWidthBound (K : Type*) [Field K] [NumberField K] (k L : ℕ) : Prop :=
  ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 K), ∀ y : v.adicCompletionIntegers K,
    y∈AddSubgroup.closure (Set.range (fun z : v.adicCompletionIntegers K => z^k)) →
    ∃ z : Fin L → v.adicCompletionIntegers K, (∑ i,z i^k)=y ∧ ∃ i, IsUnit (z i)

theorem PrimitiveWidthBound.local_unit {k L s : ℕ} (width : PrimitiveWidthBound K k L)
    (hk : 0<k) (hs : L≤s) {ν : 𝓞 K} (eligible : Eligible k ν) : LocalUnitSolvable k s ν := by
  apply localUnitSolvable_mono k hk _ hs
  intro v
  exact width v _ (map_mem_power_closure k (algebraMap (𝓞 K) (v.adicCompletionIntegers K)) eligible)

def LocalAllMarkedCore (W : TraceSumFamily K) (k s : ℕ) (ρ : ℝ) : Prop :=
  ∃ C c A B H δ : ℝ, 0<C ∧ 0<c ∧ 0≤B ∧ 0≤H ∧ 0<δ ∧
  ∀ Q : ℝ, 1≤Q → ∀ X₀ : ℝ, 1≤X₀ → ∃ N : ℝ, 0<N ∧
    ∀ ν : 𝓞 K, TotallyPositive ν → LocalUnitSolvable k s ν → N<absNorm ν →
    ∃ X : ℕ, X₀≤(X:ℝ) ∧ Nonempty (AllMarkedCore W k s X ν Q C c A B H δ ρ)

theorem UniformAllMarkedCore.of_width {W : TraceSumFamily K} {k s L : ℕ} {ρ : ℝ}
    (loc : LocalAllMarkedCore W k s ρ) (hk : 0<k) (hs : L≤s) (width : PrimitiveWidthBound K k L) :
    UniformAllMarkedCore W k s ρ := by
  obtain ⟨C,c,A,B,H,δ,hC,hc,hB,hH,hδ,h⟩ := loc
  refine ⟨C,c,A,B,H,δ,hC,hc,hB,hH,hδ,?_⟩
  intro Q hQ X₀ hX
  obtain ⟨N,hN,core⟩ := h Q hQ X₀ hX
  exact ⟨N,hN,fun ν hp eligible hn => core ν hp (width.local_unit hk hs eligible) hn⟩

/-- The analytic assumptions are required only for locally soluble targets.
A local width bound suffices for every globally eligible target. -/
theorem waring_siegel_max_of_primitive_width (W : ℝ → TraceSumFamily K) (k L : ℕ)
    (hk : 2501≤k) (width : PrimitiveWidthBound K k L) (count : DifferencingCounts W k)
    (shorten : ShorteningStep fieldConductorStage (cutoffAdmissible W k) k)
    (arcs : ∀ r a : ℕ, Even r → Even a → ((r+a+1:ℕ):ℝ)/k<6873/1000 →
      ∃ η₀ : ℝ, 0<η₀ ∧ ∀ η : ℝ, 0<η → η≤η₀ →
        Nonempty (MarkedBroadArcBounds (W η) k r a (1/(15*k))) ∧
        LocalAllMarkedCore (W η) k (max L (r+a+1)) (1/(15*k))) :
    WaringSiegelBound K k (max L (6873*k/1000)) := by
  apply field_max_width_linear_bound W k L hk count shorten
  intro r a er ea price
  obtain ⟨u,h₁,h⟩ := arcs r a er ea price
  refine ⟨u,h₁,?_⟩
  intro η hη hu
  obtain ⟨b,core⟩ := h η hη hu
  exact ⟨b,UniformAllMarkedCore.of_width core (by omega) (le_max_left _ _) width⟩

#print axioms PrimitiveWidthBound.local_unit
#print axioms waring_siegel_max_of_primitive_width
end WaringLinear
