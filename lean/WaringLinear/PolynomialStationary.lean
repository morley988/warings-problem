import WaringSiegel.WSL4WeilRingCharacters
import Mathlib.Algebra.Polynomial.Taylor

/-! # Local stationary phase for polynomial sums in a finite ring

Square-zero translations remove the nonstationary residue classes, allowing an
arbitrary weight invariant under those translations. A unique stationary coset
then gives an exact complete sum, including its phase.
-/
noncomputable section
namespace WaringLinear
open scoped BigOperators Classical
open Polynomial

theorem polynomial_shift_of_square_zero {A : Type*} [CommRing A] (f : Polynomial A)
    (x t c : A) (hc : c^2=0) :
    f.eval (x+c*t)=f.eval x+(c*f.derivative.eval x)*t := by
  rw [f.eval_add_of_sq_eq_zero x (c*t) (by rw [mul_pow,hc,zero_mul])]
  ring

theorem weighted_polynomial_stationary_filter
    {A : Type*} [CommRing A] [Fintype A]
    (ψ : AddChar A ℂ) (hψ : ψ.IsPrimitive) (f : Polynomial A) (c : A) (hc : c^2=0)
    (w : A → ℂ) (hw : ∀ x t, w (x+c*t)=w x) :
    (∑ x : A, w x*ψ (f.eval x)) =
      ∑ x ∈ Finset.univ.filter (fun x : A => c*(f.derivative.eval x)=0), w x*ψ (f.eval x) := by
  have hshift (t : A) :
      (∑ x : A, w (x+c*t)*ψ (f.eval (x+c*t))) =
        ∑ x : A, w x*ψ (f.eval x) :=
    (Equiv.addRight (c*t)).bijective.sum_comp (fun x : A => w x*ψ (f.eval x))
  have hchar (x : A) : (∑ t : A, ψ ((c*(f.derivative.eval x))*t)) =
      if c*(f.derivative.eval x)=0 then (Fintype.card A : ℂ) else 0 := by
    simpa [mul_comm] using AddChar.sum_mulShift (c*(f.derivative.eval x)) hψ
  have he : (Fintype.card A : ℂ)*(∑ x : A, w x*ψ (f.eval x)) =
      (Fintype.card A : ℂ)*
        (∑ x ∈ Finset.univ.filter (fun x : A => c*(f.derivative.eval x)=0), w x*ψ (f.eval x)) := by
    calc
      _ = ∑ t : A, ∑ x : A, w (x+c*t)*ψ (f.eval (x+c*t)) := by
        simp only [hshift, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ = ∑ x : A, ∑ t : A, (w x*ψ (f.eval x))*ψ ((c*(f.derivative.eval x))*t) := by
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl
        intro x _
        apply Finset.sum_congr rfl
        intro t _
        rw [hw, polynomial_shift_of_square_zero f x t c hc, ψ.map_add_eq_mul]
        ring
      _ = ∑ x : A, (w x*ψ (f.eval x))*
          (if c*(f.derivative.eval x)=0 then (Fintype.card A : ℂ) else 0) := by
        simp only [← Finset.mul_sum, hchar]
      _ = _ := by
        rw [Finset.mul_sum, Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro x _
        split_ifs <;> ring
  exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr Fintype.card_ne_zero) he

variable {A : Type*} [CommRing A] [Fintype A]

/-- The exact complete sum over a permitted residue class with a single
stationary coset. The coset is the image of the principal ideal generated by c. -/
theorem stationary_single_coset (ψ : AddChar A ℂ) (hψ : ψ.IsPrimitive)
    (f : Polynomial A) (c x₀ : A) (hc : c^2=0)
    (S : Finset A) (hS : ∀ x t, x+c*t∈S ↔ x∈S)
    (hcrit : ∀ x, x∈S ∧ c*f.derivative.eval x=0 ↔ x-x₀∈Ideal.span {c}) :
    (∑ x ∈ S, ψ (f.eval x)) = (Fintype.card (Ideal.span {c}:Ideal A):ℂ)*ψ (f.eval x₀) := by
  classical
  let I : Ideal A := Ideal.span {c}
  let R := Finset.univ.filter (fun x : A => x-x₀∈I)
  let w (x : A) : ℂ := if x∈S then 1 else 0
  have h0 : x₀∈S ∧ c*f.derivative.eval x₀=0 := (hcrit x₀).2 (by simp)
  have hw (x t : A) : w (x+c*t)=w x := by simp only [w,hS]
  have filtered := weighted_polynomial_stationary_filter ψ hψ f c hc w hw
  have hfilter : (∑ x∈S, ψ (f.eval x)) = ∑ x∈R, ψ (f.eval x) := by
    calc
      _ = ∑ x : A, w x*ψ (f.eval x) := by
        simp only [w,ite_mul,one_mul,zero_mul,← Finset.sum_filter]; simp
      _ = _ := filtered
      _ = ∑ x∈R, ψ (f.eval x) := by
        unfold R w
        simp only [Finset.sum_filter,ite_mul,one_mul,zero_mul]
        apply Finset.sum_congr rfl
        intro x _
        have hxx := hcrit x
        change (x∈S ∧ c*f.derivative.eval x=0 ↔ x-x₀∈I) at hxx
        split_ifs <;> tauto
  have hconstant (x : A) (hx : x∈R) : f.eval x=f.eval x₀ := by
    have hxI := (Finset.mem_filter.mp hx).2
    obtain ⟨t,ht⟩ := Ideal.mem_span_singleton.mp hxI
    have heq : x=x₀+c*t := by linear_combination ht
    rw [heq,polynomial_shift_of_square_zero f _ _ _ hc,h0.2,zero_mul,add_zero]
  let e : I ≃ R := { 
    toFun d := ⟨x₀+(d:A),Finset.mem_filter.mpr ⟨Finset.mem_univ _,by simpa using d.2⟩⟩
    invFun x := ⟨x.1-x₀,(Finset.mem_filter.mp x.2).2⟩
    left_inv d := by ext; simp
    right_inv x := by ext; simp }
  have hcard : R.card = Fintype.card I := by simpa using (Fintype.card_congr e).symm
  rw [hfilter]
  calc
    _ = ∑ _x∈R, ψ (f.eval x₀) := Finset.sum_congr rfl (fun x hx => by rw [hconstant x hx])
    _ = _ := by simp [hcard,nsmul_eq_mul,I]

theorem norm_stationary_single_coset (ψ : AddChar A ℂ) (hψ : ψ.IsPrimitive)
    (f : Polynomial A) (c x₀ : A) (hc : c^2=0)
    (S : Finset A) (hS : ∀ x t, x+c*t∈S ↔ x∈S)
    (hcrit : ∀ x, x∈S ∧ c*f.derivative.eval x=0 ↔ x-x₀∈Ideal.span {c}) :
    ‖∑ x ∈ S, ψ (f.eval x)‖ = Fintype.card (Ideal.span {c}:Ideal A) := by
  rw [stationary_single_coset ψ hψ f c x₀ hc S hS hcrit,norm_mul,AddChar.norm_apply,mul_one]
  simp

#print axioms weighted_polynomial_stationary_filter
#print axioms stationary_single_coset
#print axioms norm_stationary_single_coset
end WaringLinear
