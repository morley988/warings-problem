import Mathlib.RingTheory.AdicCompletion.Basic
import Mathlib.RingTheory.LocalRing.Basic
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Tactic.Ring

/-! # Cube sums and complete local rings

The five-cube identity holds on the additive span of cubes once 2 is a unit.
On a complete local ring at 3 the image of every single unit cube contains its
whole coset modulo 9. The proof uses a contracting iteration on the ring.
-/

namespace WaringLinear.CubicLocalLifting

variable {R : Type*} [CommRing R]

/-- Every element in the additive group generated by cubes is a cube modulo 3. -/
theorem cube_mod_three_of_mem_span {z : R}
    (hz : z ∈ AddSubgroup.closure (Set.range fun x : R => x ^ 3)) :
    ∃ a b : R, z = a ^ 3 + 3 * b := by
  induction hz using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := hx
    exact ⟨a, 0, by ring⟩
  | zero => exact ⟨0, 0, by ring⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨c, e, rfl⟩ := hy
    exact ⟨a+c, b+e-a*c*(a+c), by ring⟩
  | neg x _ hx =>
    obtain ⟨a, b, rfl⟩ := hx
    exact ⟨-a, -b, by ring⟩

/-- Five cubes suffice on the cube span in a local ring in which 2 is a unit.
At least one of the five roots is a unit. -/
theorem five_cubes_with_unit [IsLocalRing R] (h₂ : IsUnit (2 : R)) {z : R}
    (hz : z ∈ AddSubgroup.closure (Set.range fun x : R => x ^ 3)) :
    ∃ a b c d e : R, z = a^3 + b^3 + c^3 + d^3 + e^3 ∧
      (IsUnit a ∨ IsUnit b ∨ IsUnit c ∨ IsUnit d ∨ IsUnit e) := by
  obtain ⟨a, b, hz'⟩ := cube_mod_three_of_mem_span hz
  obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp h₂
  let t := v*b
  have ht : (2:R)*t = b := by simp [t, ← mul_assoc, hv]
  refine ⟨a, t+1, t-1, -t, -t, ?_, ?_⟩
  · calc
      z = a^3 + 3*((2:R)*t) := by rw [ht, hz']
      _ = _ := by ring
  · rcases IsLocalRing.isUnit_or_isUnit_of_add_one
        (show (t+1)+(-t) = 1 by ring) with h | h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))

/-- A map that gains an ideal power on every difference has a fixed point
in an adically complete ring. -/
theorem exists_adic_fixed_point (I : Ideal R) [IsAdicComplete I R]
    (f : R → R) (gain : ∀ n : ℕ, ∀ x y : R, x-y ∈ I^n → f x-f y ∈ I^(n+1)) :
    ∃ a : R, f a = a := by
  let c : ℕ → R := fun n => Nat.rec 0 (fun _ x => f x) n
  have hstep (n : ℕ) : c (n+1) = f (c n) := rfl
  have hsucc (n : ℕ) : c n - c (n+1) ∈ I^n := by
    induction n with
    | zero => simp
    | succ n ih =>
      simpa only [hstep] using gain n (c n) (c (n+1)) ih
  have hc : AdicCompletion.IsAdicCauchy I R c := by
    apply (AdicCompletion.isAdicCauchy_iff I R c).2
    intro n
    simpa only [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top] using hsucc n
  obtain ⟨a, ha⟩ := IsPrecomplete.prec' c hc
  refine ⟨a, (IsHausdorff.eq_iff_smodEq (I := I)).mpr ?_⟩
  intro n
  have hn := ha n
  have hn' := ha (n+1)
  simp only [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top] at hn hn' ⊢
  have ha' : a-c n ∈ I^n := by simpa using (I^n).neg_mem hn
  have hdiff := gain n a (c n) ha'
  have hlim : f (c n)-a ∈ I^(n+1) := hstep n ▸ hn'
  exact Ideal.pow_le_pow_right (Nat.le_succ n)
    (by simpa only [sub_add_sub_cancel] using (I^(n+1)).add_mem hdiff hlim)

/-- A unit cube realizes every change by a multiple of 9 using a root
congruent to the original root modulo 3. Works for any ideal containing
3 at which the ring is adically complete. -/
theorem unit_cube_coset (I : Ideal R) [IsAdicComplete I R] (h₃ : (3:R) ∈ I)
    (u : Rˣ) (b : R) : ∃ h : R, ((u:R)+3*h)^3 = (u:R)^3 + 9*b := by
  let v : R := ↑u⁻¹
  let f : R → R := fun h => v^2*(b-3*(u:R)*h^2-3*h^3)
  have gain (n : ℕ) (x y : R) (hxy : x-y ∈ I^n) : f x-f y ∈ I^(n+1) := by
    let t := -v^2*((u:R)*(x+y)+x^2+x*y+y^2)
    have he : f x - f y = ((x-y)*3)*t := by dsimp [f,t]; ring
    rw [he,pow_succ]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_mul hxy h₃)
  obtain ⟨h, hh⟩ := exists_adic_fixed_point I f gain
  have huv : (u:R)*v = 1 := Units.mul_inv u
  have hh' : (u:R)^2*h = b-3*(u:R)*h^2-3*h^3 := by
    calc
      (u:R)^2*h = (u:R)^2*f h := by rw [hh]
      _ = ((u:R)*v)^2*(b-3*(u:R)*h^2-3*h^3) := by dsimp [f]; ring
      _ = _ := by rw [huv]; ring
  refine ⟨h, ?_⟩
  calc
    ((u:R)+3*h)^3 = (u:R)^3+9*((u:R)^2*h+3*(u:R)*h^2+3*h^3) := by ring
    _ = _ := by rw [hh']; ring

#print axioms cube_mod_three_of_mem_span
#print axioms five_cubes_with_unit
#print axioms exists_adic_fixed_point
#print axioms unit_cube_coset
end WaringLinear.CubicLocalLifting
