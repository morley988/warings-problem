def wordPairOK (p : List Bool × Pair) : Bool := validWord p.1 && pairOfWord p.1 == p.2

set_option maxRecDepth 32768
set_option maxHeartbeats 100000000
theorem bankAll : pairBank.toList.all wordPairOK = true := by decide +kernel

theorem bank_sound (p : List Bool × Pair) (hp : p ∈ pairBank.toList) (k : Nat) (hk : 21≤k) :
    pairOfWord p.1 = p.2 ∧ SafeAt k (0,1) (1,0) p.1.reverse := by
  have h := List.all_eq_true.mp bankAll p hp
  simp only [wordPairOK,Bool.and_eq_true,beq_iff_eq] at h
  exact ⟨h.2,avoidsPoles_sound _ _ _ h.1 k hk⟩

#print axioms bank_sound
end WaringDualEnvelope
