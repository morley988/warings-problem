import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.CharP.Two
import Mathlib.RingTheory.LocalRing.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Mathlib.RingTheory.Nilpotent.Defs
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum

/-!
# Checked algebraic components for number-field cubes

These statements concern actual cube representations in commutative rings.
They do not assert an archimedean Waring bound or a circle-method estimate.
The local-ring theorem proves the five-cube lemma wherever 2 is a unit;
in particular it supplies the algebraic step at residue characteristic 3.
-/

namespace WaringSiegel

open scoped BigOperators

variable {R : Type*} [CommRing R]

/-- The additive subgroup generated by all cubes. -/
def cubeSpan (R : Type*) [CommRing R] : AddSubgroup R :=
  AddSubgroup.closure (Set.range fun x : R => x ^ 3)

theorem cube_mem_cubeSpan (x : R) : x ^ 3 ∈ cubeSpan R :=
  AddSubgroup.subset_closure ⟨x, rfl⟩

/-- Global cubic eligibility maps to local cubic eligibility under any ring map. -/
theorem map_mem_cubeSpan {S : Type*} [CommRing S] (f : R →+* S)
    {a : R} (ha : a ∈ cubeSpan R) : f a ∈ cubeSpan S := by
  have hle : cubeSpan R ≤ (cubeSpan S).comap f.toAddMonoidHom := by
    apply (AddSubgroup.closure_le _).mpr
    rintro y ⟨x, rfl⟩
    change f (x ^ 3) ∈ cubeSpan S
    rw [map_pow]
    exact cube_mem_cubeSpan (f x)
  exact hle ha

/-- This polarization identity works without any characteristic assumption. -/
theorem four_cube_identity (z : R) :
    (1 - z) ^ 3 + (-1 - z) ^ 3 + z ^ 3 + z ^ 3 = -6 * z := by
  ring

theorem six_mul_mem_cubeSpan (a : R) : 6 * a ∈ cubeSpan R := by
  have h := (cubeSpan R).add_mem
    ((cubeSpan R).add_mem
      ((cubeSpan R).add_mem (cube_mem_cubeSpan (1 - -a))
        (cube_mem_cubeSpan (-1 - -a)))
      (cube_mem_cubeSpan (-a))) (cube_mem_cubeSpan (-a))
  have hid := four_cube_identity (-a)
  have hval : -6 * -a = (6 : R) * a := by ring
  rw [hid, hval] at h
  exact h

/-- The inverse image of the cubes modulo the principal ideal generated by 3,
written constructively as a cube plus three times another ring element. -/
def cubeModThree (R : Type*) [CommRing R] : AddSubgroup R where
  carrier := {a | ∃ b c : R, a = b ^ 3 + 3 * c}
  zero_mem' := ⟨0, 0, by ring⟩
  add_mem' := by
    rintro a d ⟨b, c, rfl⟩ ⟨e, f, rfl⟩
    refine ⟨b + e, c + f - b * e * (b + e), ?_⟩
    ring
  neg_mem' := by
    rintro a ⟨b, c, rfl⟩
    refine ⟨-b, -c, ?_⟩
    ring

theorem cubeSpan_le_cubeModThree : cubeSpan R ≤ cubeModThree R := by
  apply (AddSubgroup.closure_le _).mpr
  rintro a ⟨b, rfl⟩
  exact ⟨b, 0, by ring⟩

theorem exists_cube_plus_three_mul {a : R} (ha : a ∈ cubeSpan R) :
    ∃ b c : R, a = b ^ 3 + 3 * c :=
  cubeSpan_le_cubeModThree ha

/-- Admissibility depends only on the residue class modulo 6. -/
theorem cubeSpan_membership_mod_six {a b c : R} (hab : a = b + 6 * c) :
    a ∈ cubeSpan R ↔ b ∈ cubeSpan R := by
  rw [hab]
  constructor
  · intro h
    have hsub := (cubeSpan R).sub_mem h (six_mul_mem_cubeSpan c)
    simpa using hsub
  · intro h
    exact (cubeSpan R).add_mem h (six_mul_mem_cubeSpan c)

/-- Every image of an admissible element in a characteristic-three ring is a cube. -/
theorem image_is_cube_in_characteristic_three {S : Type*} [CommRing S]
    (f : R →+* S) (h3 : (3 : S) = 0) {a : R} (ha : a ∈ cubeSpan R) :
    ∃ b : S, f a = b ^ 3 := by
  obtain ⟨b, c, hbc⟩ := exists_cube_plus_three_mul ha
  refine ⟨f b, ?_⟩
  rw [hbc]
  simp only [map_add, map_pow, map_mul, map_ofNat, h3, zero_mul, add_zero]

/-- Nilpotents create no extra additive-cube obstruction in characteristic 2.
This is the algebraic lifting step used for the dyadic admissibility criterion. -/
theorem nilpotent_mem_cubeSpan_char_two [CharP R 2] {z : R} (hz : IsNilpotent z) :
    z ∈ cubeSpan R := by
  obtain ⟨n, hn⟩ := hz
  have hzn : z ^ (2 ^ n) = 0 := pow_eq_zero_of_le (Nat.lt_two_pow_self.le) hn
  have hpow : (1 + z) ^ (2 ^ n) = 1 := by
    rw [add_pow_char_pow, one_pow, hzn, add_zero]
  have horder : orderOf (1 + z) ∣ 2 ^ n := orderOf_dvd_of_pow_eq_one hpow
  have hcop : Nat.Coprime 3 (orderOf (1 + z)) :=
    Nat.Coprime.of_dvd_right horder ((show Nat.Coprime 3 2 by decide).pow_right n)
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime hcop
  have hcube : ((1 + z) ^ m) ^ 3 = 1 + z := by
    simpa only [← pow_mul, Nat.mul_comm] using hm
  have hmem := (cubeSpan R).sub_mem (cube_mem_cubeSpan ((1 + z) ^ m))
    (cube_mem_cubeSpan (1 : R))
  rw [hcube, one_pow] at hmem
  simpa using hmem

/-- A cube plus a multiple of 3 is an actual sum of five cubes if 2 is invertible. -/
theorem exists_five_cubes_of_cube_plus_three_mul
    (h2 : IsUnit (2 : R)) {a b c : R} (ha : a = b ^ 3 + 3 * c) :
    ∃ z : R, a = b ^ 3 + (1 - z) ^ 3 + (-1 - z) ^ 3 + z ^ 3 + z ^ 3 := by
  obtain ⟨d, hd⟩ := isUnit_iff_exists_inv.mp h2
  refine ⟨-(d * c), ?_⟩
  have hz : (-6 : R) * -(d * c) = 3 * c := by
    calc
      (-6 : R) * -(d * c) = (3 * c) * (2 * d) := by ring
      _ = 3 * c := by rw [hd, mul_one]
  calc
    a = b ^ 3 + 3 * c := ha
    _ = b ^ 3 + (-6 : R) * -(d * c) := by rw [hz]
    _ = b ^ 3 + (1 - -(d * c)) ^ 3 + (-1 - -(d * c)) ^ 3 +
        (-(d * c)) ^ 3 + (-(d * c)) ^ 3 := by
      rw [← four_cube_identity (-(d * c))]
      ring

theorem exists_five_cubes_of_mem_cubeSpan (h2 : IsUnit (2 : R))
    {a : R} (ha : a ∈ cubeSpan R) :
    ∃ b z : R,
      a = b ^ 3 + (1 - z) ^ 3 + (-1 - z) ^ 3 + z ^ 3 + z ^ 3 := by
  obtain ⟨b, c, hbc⟩ := exists_cube_plus_three_mul ha
  obtain ⟨z, hz⟩ := exists_five_cubes_of_cube_plus_three_mul h2 hbc
  exact ⟨b, z, hz⟩

theorem mem_cubeSpan_iff_cube_plus_three_mul (h2 : IsUnit (2 : R)) (a : R) :
    a ∈ cubeSpan R ↔ ∃ b c : R, a = b ^ 3 + 3 * c := by
  constructor
  · exact exists_cube_plus_three_mul
  · rintro ⟨b, c, ha⟩
    obtain ⟨z, hz⟩ := exists_five_cubes_of_cube_plus_three_mul h2 ha
    rw [hz]
    exact (cubeSpan R).add_mem
      ((cubeSpan R).add_mem
        ((cubeSpan R).add_mem
          ((cubeSpan R).add_mem (cube_mem_cubeSpan b) (cube_mem_cubeSpan (1 - z)))
          (cube_mem_cubeSpan (-1 - z)))
        (cube_mem_cubeSpan z)) (cube_mem_cubeSpan z)

/-- If the two displayed coordinates were nonunits, their difference 2 would
be a nonunit. The locality assumption is substantive and remains visible. -/
theorem unit_in_five_cube_identity [IsLocalRing R]
    (h2 : IsUnit (2 : R)) (z : R) :
    IsUnit (1 - z) ∨ IsUnit (-1 - z) := by
  have hsum : IsUnit ((1 - z) + -(-1 - z)) := by
    convert h2 using 1
    ring
  rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hsum with h | h
  · exact Or.inl h
  · exact Or.inr ((IsUnit.neg_iff (-1 - z)).mp h)

/-- Away from residue characteristics 2 and 3 the same identity gives four
actual cubes for every target, including a unit coordinate. -/
theorem exists_four_cubes_with_unit [IsLocalRing R]
    (h2 : IsUnit (2 : R)) (h3 : IsUnit (3 : R)) (a : R) :
    ∃ z : R,
      a = (1 - z) ^ 3 + (-1 - z) ^ 3 + z ^ 3 + z ^ 3 ∧
      (IsUnit (1 - z) ∨ IsUnit (-1 - z)) := by
  have h6 : IsUnit (6 : R) := by
    convert h2.mul h3 using 1
    ring
  obtain ⟨d, hd⟩ := isUnit_iff_exists_inv.mp h6
  refine ⟨-(d * a), ?_, unit_in_five_cube_identity h2 (-(d * a))⟩
  rw [four_cube_identity]
  calc
    a = (6 * d) * a := by rw [hd, one_mul]
    _ = (-6 : R) * -(d * a) := by ring

/-- The algebraic local five-cube theorem, including a unit coordinate. -/
theorem exists_five_cubes_with_unit [IsLocalRing R]
    (h2 : IsUnit (2 : R)) {a : R} (ha : a ∈ cubeSpan R) :
    ∃ b z : R,
      a = b ^ 3 + (1 - z) ^ 3 + (-1 - z) ^ 3 + z ^ 3 + z ^ 3 ∧
      (IsUnit (1 - z) ∨ IsUnit (-1 - z)) := by
  obtain ⟨b, z, hz⟩ := exists_five_cubes_of_mem_cubeSpan h2 ha
  exact ⟨b, z, hz, unit_in_five_cube_identity h2 z⟩

theorem two_isUnit_of_residue_char_three [IsLocalRing R]
    [CharP (IsLocalRing.ResidueField R) 3] : IsUnit (2 : R) := by
  apply (IsLocalRing.residue_ne_zero_iff_isUnit (2 : R)).mp
  simp only [map_ofNat]
  change ¬ ((2 : ℕ) : IsLocalRing.ResidueField R) = 0
  rw [CharP.cast_eq_zero_iff (IsLocalRing.ResidueField R) 3]
  decide

/-- The exact local five-cube conclusion at residue characteristic three.
No Hensel lifting or analytic representation hypothesis is assumed here. -/
theorem five_cubes_residue_char_three [IsLocalRing R]
    [CharP (IsLocalRing.ResidueField R) 3] {a : R} (ha : a ∈ cubeSpan R) :
    ∃ b z : R,
      a = b ^ 3 + (1 - z) ^ 3 + (-1 - z) ^ 3 + z ^ 3 + z ^ 3 ∧
      (IsUnit (1 - z) ∨ IsUnit (-1 - z)) :=
  exists_five_cubes_with_unit two_isUnit_of_residue_char_three ha

/-- Tuple version suitable for local-solubility interfaces. -/
theorem five_cubes_tuple_with_unit [IsLocalRing R]
    (h2 : IsUnit (2 : R)) {a : R} (ha : a ∈ cubeSpan R) :
    ∃ x : Fin 5 → R, (∑ i, x i ^ 3) = a ∧ ∃ i, IsUnit (x i) := by
  obtain ⟨b, z, hz, hu⟩ := exists_five_cubes_with_unit h2 ha
  refine ⟨![b, 1 - z, -1 - z, z, z], ?_, ?_⟩
  · simpa [Fin.sum_univ_succ, add_assoc] using hz.symm
  · rcases hu with h | h
    · exact ⟨1, by simpa using h⟩
    · exact ⟨2, by simpa using h⟩

theorem four_cubes_tuple_with_unit [IsLocalRing R]
    (h2 : IsUnit (2 : R)) (h3 : IsUnit (3 : R)) (a : R) :
    ∃ x : Fin 4 → R, (∑ i, x i ^ 3) = a ∧ ∃ i, IsUnit (x i) := by
  obtain ⟨z, hz, hu⟩ := exists_four_cubes_with_unit h2 h3 a
  refine ⟨![1 - z, -1 - z, z, z], ?_, ?_⟩
  · simpa [Fin.sum_univ_succ, add_assoc] using hz.symm
  · rcases hu with h | h
    · exact ⟨0, by simpa using h⟩
    · exact ⟨1, by simpa using h⟩

/-- Exact kernel computation, with no native_decide, for the exceptional field F_7. -/
theorem three_cubes_mod_seven :
    ∀ a : ZMod 7, ∃ x y z : ZMod 7,
      x ^ 3 + y ^ 3 + z ^ 3 = a ∧ (x ≠ 0 ∨ y ≠ 0 ∨ z ≠ 0) := by
  decide

/-- Exact kernel computation, with no native_decide, for the exceptional field F_13. -/
theorem two_cubes_mod_thirteen :
    ∀ a : ZMod 13, ∃ x y : ZMod 13,
      x ^ 3 + y ^ 3 = a ∧ (x ≠ 0 ∨ y ≠ 0) := by
  decide

end WaringSiegel

