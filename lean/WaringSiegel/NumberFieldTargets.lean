import Mathlib.NumberTheory.NumberField.Norm
import Mathlib.RingTheory.DedekindDomain.AdicValuation
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Data.Real.Basic
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Data.Fintype.Pi

/-!
# Literal number-field Waring–Siegel targets

The targets below use actual algebraic integers, all real embeddings,
field norms and the integer rings of all finite completions. None is
defined as a numerical-certificate predicate. Defining a target is not
a proof of it.
-/

noncomputable section
open scoped NumberField BigOperators

namespace WaringSiegel

variable {K : Type*} [Field K] [NumberField K]

def TotallyPositive (x : 𝓞 K) : Prop :=
  ∀ σ : K →+* ℝ, 0 < σ (x : K)

def TotallyNonnegative (x : 𝓞 K) : Prop :=
  ∀ σ : K →+* ℝ, 0 ≤ σ (x : K)

/-- Absolute algebraic norm, viewed as a nonnegative real number. -/
def absNorm (x : 𝓞 K) : ℝ := |(Algebra.norm ℤ x : ℝ)|

theorem absNorm_nonneg (x : 𝓞 K) : 0 ≤ absNorm x := abs_nonneg _

/-- The additive subgroup generated by integral kth powers. -/
def powerSubgroup (k : ℕ) : AddSubgroup (𝓞 K) :=
  AddSubgroup.closure (Set.range fun x : 𝓞 K => x ^ k)

def Eligible (k : ℕ) (ν : 𝓞 K) : Prop := ν ∈ powerSubgroup k

/-- At most s totally nonnegative roots, with the manuscript's norm bound. -/
def RepresentableByAtMost (k s : ℕ) (C : ℝ) (ν : 𝓞 K) : Prop :=
  ∃ t : ℕ, t ≤ s ∧ ∃ x : Fin t → 𝓞 K,
    (∀ i, TotallyNonnegative (x i)) ∧
    (∑ i, (x i) ^ k = ν) ∧
    (∀ i, absNorm (x i) ≤ C * absNorm ν ^ (1 / (k : ℝ)))

/-- A bound for the actual Waring–Siegel problem over one fixed field. -/
def WaringSiegelBound (K : Type*) [Field K] [NumberField K] (k s : ℕ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∃ N₀ : ℝ, 0 < N₀ ∧ ∀ ν : 𝓞 K,
    TotallyPositive ν → Eligible k ν → N₀ < absNorm ν →
      RepresentableByAtMost k s C ν

/-- All-field uniformity of the number of summands, with field-dependent
constants and size thresholds. -/
def UniformWaringSiegelBound (k s : ℕ) : Prop :=
  ∀ (K : Type) [Field K] [NumberField K], WaringSiegelBound K k s

/-- The exact local hypothesis in the large-k manuscript. A unit coordinate
is required in each actual completed integer ring. -/
def LocalUnitSolvable (k s : ℕ) (ν : 𝓞 K) : Prop :=
  ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
    ∃ x : Fin s → v.adicCompletionIntegers K,
      (∑ i, (x i) ^ k = algebraMap (𝓞 K) (v.adicCompletionIntegers K) ν) ∧
      ∃ i, IsUnit (x i)

/-- The local-conditional analytic target; eligibility is not silently
substituted for its stronger unit-coordinate local hypothesis. -/
def LocalConditionalBound (K : Type*) [Field K] [NumberField K] (k s : ℕ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∃ N₀ : ℝ, 0 < N₀ ∧ ∀ ν : 𝓞 K,
    TotallyPositive ν → LocalUnitSolvable k s ν → N₀ < absNorm ν →
      RepresentableByAtMost k s C ν

theorem RepresentableByAtMost.mono {k s t : ℕ} {C : ℝ} {ν : 𝓞 K}
    (h : RepresentableByAtMost k s C ν) (hst : s ≤ t) :
    RepresentableByAtMost k t C ν := by
  obtain ⟨r, hrs, x, hpos, hsum, hnorm⟩ := h
  exact ⟨r, hrs.trans hst, x, hpos, hsum, hnorm⟩

theorem WaringSiegelBound.mono {k s t : ℕ}
    (h : WaringSiegelBound K k s) (hst : s ≤ t) : WaringSiegelBound K k t := by
  obtain ⟨C, hC, N₀, hN₀, h⟩ := h
  exact ⟨C, hC, N₀, hN₀, fun ν hp he hN => (h ν hp he hN).mono hst⟩

/-- This is a logical assembly lemma. The local theorem remains an explicit
premise; it is not asserted here for any exponent. -/
theorem bound_of_localConditionalBound {k s : ℕ}
    (hanalytic : LocalConditionalBound K k s)
    (hlocal : ∀ ν : 𝓞 K, Eligible k ν → LocalUnitSolvable k s ν) :
    WaringSiegelBound K k s := by
  obtain ⟨C, hC, N₀, hN₀, h⟩ := hanalytic
  exact ⟨C, hC, N₀, hN₀, fun ν hp he hN => h ν hp (hlocal ν he) hN⟩

/-- Count actual ordered algebraic-integer tuples from a finite candidate set.
No height-bounded norm shell is assumed finite: units would make that wrong. -/
def representationCount (k s : ℕ) (ν : 𝓞 K)
    (A : Finset (Fin s → 𝓞 K)) : ℕ := by
  classical
  exact (A.filter fun x => ∑ i, (x i) ^ k = ν).card

theorem representationCount_pos_iff (k s : ℕ) (ν : 𝓞 K)
    (A : Finset (Fin s → 𝓞 K)) :
    0 < representationCount k s ν A ↔
      ∃ x ∈ A, ∑ i, (x i) ^ k = ν := by
  classical
  simp only [representationCount, Finset.card_pos, Finset.Nonempty, Finset.mem_filter]

theorem representable_of_count_pos {k s : ℕ} {C : ℝ} {ν : 𝓞 K}
    {A : Finset (Fin s → 𝓞 K)}
    (hA : ∀ x ∈ A, (∀ i, TotallyNonnegative (x i)) ∧
      (∀ i, absNorm (x i) ≤ C * absNorm ν ^ (1 / (k : ℝ))))
    (hcount : 0 < representationCount k s ν A) :
    RepresentableByAtMost k s C ν := by
  obtain ⟨x, hx, hsum⟩ := (representationCount_pos_iff k s ν A).mp hcount
  exact ⟨s, le_rfl, x, (hA x hx).1, hsum, (hA x hx).2⟩

end WaringSiegel
