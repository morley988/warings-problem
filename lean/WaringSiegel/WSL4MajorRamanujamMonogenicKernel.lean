import WaringSiegel.WSL4MajorRamanujamPrincipalRoots
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.Algebra.Polynomial.Lifts
import Mathlib.FieldTheory.PrimitiveElement
import Mathlib.FieldTheory.Finite.Basic

/-!
# A monogenic integral coefficient ring with exact residue kernel p

The construction starts with an actual power basis of the residue field,
lifts its minimal polynomial over the integers, and computes the kernel
of the resulting residue map. No unramified coefficient-field embedding
or Cohen structure theorem is assumed.
-/
noncomputable section
set_option maxHeartbeats 1500000
open Polynomial IsLocalRing
open scoped Classical
namespace WaringSiegel.WSL4

variable (p : ℕ) [Fact p.Prime]
variable {L : Type*} [Field L] [Algebra (ZMod p) L]

theorem integer_polynomial_eval_mod_prime (Q : ℤ[X]) (a : L) :
    aeval a (Q.map (Int.castRingHom (ZMod p)))=Q.eval₂ (Int.castRingHom L) a := by
  rw [aeval_def,eval₂_map]
  congr 1
  ext z
  simp

theorem exists_integer_monic_minpoly_lift (pb : PowerBasis (ZMod p) L) :
    ∃ F : ℤ[X],F.Monic ∧ F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen ∧
      F.natDegree=Module.finrank (ZMod p) L := by
  have hl : minpoly (ZMod p) pb.gen∈Polynomial.lifts (Int.castRingHom (ZMod p)) := by
    apply (Polynomial.mem_lifts _).mpr
    exact Polynomial.map_surjective (Int.castRingHom (ZMod p)) ZMod.intCast_surjective _
  obtain ⟨F,hF,hdeg,hmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl
    (minpoly.monic pb.isIntegral_gen)
  refine ⟨F,hmon,hF,?_⟩
  rw [hdeg,pb.natDegree_minpoly,← pb.finrank]

theorem monogenic_residue_root (pb : PowerBasis (ZMod p) L)
    (F : ℤ[X]) (hF : F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen) :
    F.eval₂ (Int.castRingHom L) pb.gen=0 := by
  rw [← integer_polynomial_eval_mod_prime p F pb.gen,hF,minpoly.aeval]

def monogenicResidueHom (pb : PowerBasis (ZMod p) L)
    (F : ℤ[X]) (hF : F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen) :
    AdjoinRoot F →+* L :=
  AdjoinRoot.lift (Int.castRingHom L) pb.gen (monogenic_residue_root p pb F hF)

@[simp] theorem monogenicResidueHom_mk (pb : PowerBasis (ZMod p) L)
    (F : ℤ[X]) (hF : F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen)
    (Q : ℤ[X]) :
    monogenicResidueHom p pb F hF (AdjoinRoot.mk F Q)=Q.eval₂ (Int.castRingHom L) pb.gen :=
  AdjoinRoot.lift_mk _ _

theorem monogenicResidueHom_surjective (pb : PowerBasis (ZMod p) L)
    (F : ℤ[X]) (hF : F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen) :
    Function.Surjective (monogenicResidueHom p pb F hF) := by
  intro a
  obtain ⟨Q,hQ⟩ := pb.exists_eq_aeval' a
  obtain ⟨T,hT⟩ := Polynomial.map_surjective (Int.castRingHom (ZMod p)) ZMod.intCast_surjective Q
  refine ⟨AdjoinRoot.mk F T,?_⟩
  rw [monogenicResidueHom_mk,← integer_polynomial_eval_mod_prime p T pb.gen,hT,← hQ]

/-- The residue kernel is exactly the principal ideal generated by the rational prime. -/
theorem monogenicResidueHom_eq_zero_iff (pb : PowerBasis (ZMod p) L)
    (F : ℤ[X]) (hF : F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen)
    (b : AdjoinRoot F) :
    monogenicResidueHom p pb F hF b=0 ↔ (p:AdjoinRoot F) ∣ b := by
  obtain ⟨Q,rfl⟩ := AdjoinRoot.mk_surjective b
  constructor
  · intro hb
    rw [monogenicResidueHom_mk] at hb
    have hd : minpoly (ZMod p) pb.gen ∣ Q.map (Int.castRingHom (ZMod p)) := by
      apply minpoly.dvd
      rw [integer_polynomial_eval_mod_prime p Q pb.gen,hb]
    obtain ⟨S,hS⟩ := hd
    obtain ⟨T,hT⟩ := Polynomial.map_surjective (Int.castRingHom (ZMod p)) ZMod.intCast_surjective S
    have hz : (Q-F*T).map (Int.castRingHom (ZMod p))=0 := by
      rw [Polynomial.map_sub,Polynomial.map_mul,hF,hT,hS,sub_self]
    have hdvd : C (p:ℤ) ∣ Q-F*T := by
      rw [C_dvd_iff_dvd_coeff]
      intro i
      apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
      have he := congrArg (fun f : (ZMod p)[X] => f.coeff i) hz
      simpa only [coeff_map,coeff_zero,Int.coe_castRingHom] using he
    obtain ⟨U,hU⟩ := hdvd
    refine ⟨AdjoinRoot.mk F U,?_⟩
    have he := congrArg (AdjoinRoot.mk F) hU
    simpa only [map_sub,map_mul,AdjoinRoot.mk_self,zero_mul,sub_zero,
      AdjoinRoot.mk_C,map_natCast] using he
  · rintro ⟨c,hc⟩
    rw [hc,map_mul,map_natCast]
    have hpzero : (p:L)=0 := by
      have he := congrArg (algebraMap (ZMod p) L) (CharP.cast_eq_zero (ZMod p) p)
      simpa only [map_natCast,map_zero] using he
    rw [hpzero,zero_mul]

theorem monogenicResidueHom_kernel (pb : PowerBasis (ZMod p) L)
    (F : ℤ[X]) (hF : F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen) :
    RingHom.ker (monogenicResidueHom p pb F hF)=Ideal.span ({(p:AdjoinRoot F)}:Set (AdjoinRoot F)) := by
  ext b
  rw [RingHom.mem_ker,monogenicResidueHom_eq_zero_iff,Ideal.mem_span_singleton]

def monogenicResidueEquiv (pb : PowerBasis (ZMod p) L)
    (F : ℤ[X]) (hF : F.map (Int.castRingHom (ZMod p))=minpoly (ZMod p) pb.gen) :
    (AdjoinRoot F ⧸ Ideal.span ({(p:AdjoinRoot F)}:Set (AdjoinRoot F))) ≃+* L :=
  (Ideal.quotEquivOfEq (monogenicResidueHom_kernel p pb F hF).symm).trans
    ((monogenicResidueHom p pb F hF).quotientKerEquivOfSurjective
      (monogenicResidueHom_surjective p pb F hF))

#print axioms exists_integer_monic_minpoly_lift
#print axioms monogenicResidueHom_surjective
#print axioms monogenicResidueHom_kernel
#print axioms monogenicResidueEquiv
end WaringSiegel.WSL4
