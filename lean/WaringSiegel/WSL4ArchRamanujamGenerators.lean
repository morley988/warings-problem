import WaringSiegel.WSL4ArchRamanujamPrecisionQuotient
import WaringSiegel.WSL4ArchFiniteAdditiveImage
import WaringSiegel.WSL4ArchLocalPowerLists

/-! # Actual power generators in the truncated-power subring

Eligibility lifts to the subgroup generated by the same literal powers in
the ghost range. No assertion that every ghost value is eligible is used.
-/
noncomputable section
open scoped BigOperators
namespace WaringSiegel.WSL4
set_option maxHeartbeats 1200000
variable {p : ℕ} [Fact p.Prime] {R : Type*} [CommRing R]

def ramanujamPowerGenerator (p n s : ℕ) [Fact p.Prime] (x : R) :
    ramanujamPowerSubring p s R :=
  ⟨x^(n*p^s),by
    simpa only [pow_mul] using prime_power_mem_ramanujamPowerSubring (p:=p) s (x^n)⟩

theorem eligible_power_generator_mem_closure (n s : ℕ) (a : R)
    (ha : a∈AddSubgroup.closure (Set.range (fun x : R => x^(n*p^s)))) :
    ∃b : ramanujamPowerSubring p s R,(b:R)=a ∧
      b∈AddSubgroup.closure (Set.range (ramanujamPowerGenerator p n s (R:=R))) := by
  let C := ramanujamPowerSubring p s R
  let H := AddSubgroup.closure (Set.range (ramanujamPowerGenerator p n s (R:=R)))
  have hle : AddSubgroup.closure (Set.range (fun x : R => x^(n*p^s)))≤
      H.map C.subtype.toAddMonoidHom := by
    apply (AddSubgroup.closure_le _).mpr
    rintro y ⟨x,rfl⟩
    exact ⟨ramanujamPowerGenerator p n s x,AddSubgroup.subset_closure ⟨x,rfl⟩,rfl⟩
  obtain ⟨b,hb,he⟩ := hle ha
  exact ⟨b,he,hb⟩

theorem ramanujamPowerGenerator_list_sum (n s : ℕ) (l : List R) :
    (((l.map (ramanujamPowerGenerator p n s)).sum : ramanujamPowerSubring p s R):R)=
      localPowerListSum (n*p^s) l := by
  change (ramanujamPowerSubring p s R).subtype ((l.map (ramanujamPowerGenerator p n s)).sum)=_
  rw [map_list_sum,List.map_map]
  rfl

theorem ramanujamPowerGenerator_quotient_mem_closure (n s : ℕ)
    (J : Ideal (ramanujamPowerSubring p s R))
    (b : ramanujamPowerSubring p s R)
    (hb : b∈AddSubgroup.closure (Set.range (ramanujamPowerGenerator p n s (R:=R)))) :
    Ideal.Quotient.mk J b∈AddSubgroup.closure
      (Set.range (fun x : R => Ideal.Quotient.mk J (ramanujamPowerGenerator p n s x))) := by
  have hle : AddSubgroup.closure (Set.range (ramanujamPowerGenerator p n s (R:=R)))≤
      (AddSubgroup.closure (Set.range (fun x : R =>
        Ideal.Quotient.mk J (ramanujamPowerGenerator p n s x)))).comap
          (Ideal.Quotient.mk J).toAddMonoidHom := by
    apply (AddSubgroup.closure_le _).mpr
    rintro y ⟨x,rfl⟩
    exact AddSubgroup.subset_closure ⟨x,rfl⟩
  exact hle hb

#print axioms eligible_power_generator_mem_closure
#print axioms ramanujamPowerGenerator_list_sum
#print axioms ramanujamPowerGenerator_quotient_mem_closure
end WaringSiegel.WSL4
