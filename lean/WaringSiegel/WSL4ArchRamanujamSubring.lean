import WaringSiegel.WSL4ArchRamanujamFinite

/-! # Coefficient subrings and the proved inclusion J_m into J'_m

For m=n*p^s, the additive span of actual m-th powers is contained in
the truncated p-power expression ring with coordinates in the subring
generated by n-th powers. Only this direction is asserted.
-/
noncomputable section
open scoped BigOperators
namespace WaringSiegel.WSL4
set_option maxHeartbeats 1000000
variable {p : ℕ} [Fact p.Prime] {R S : Type*} [CommRing R] [CommRing S]

theorem map_ramanujamPowerSum (f : R →+* S) (s : ℕ) (x : ℕ → R) :
    f (ramanujamPowerSum p s x)=ramanujamPowerSum p s (fun i => f (x i)) := by
  simp only [ramanujamPowerSum,map_sum,map_mul,map_pow,map_natCast]

def ramanujamPowerSubringOver (p s : ℕ) [Fact p.Prime] (B : Subring R) : Subring R :=
  (ramanujamPowerSubring p s B).map B.subtype

theorem mem_ramanujamPowerSubringOver_iff (s : ℕ) (B : Subring R) (a : R) :
    a∈ramanujamPowerSubringOver p s B ↔
      ∃x : ℕ → R,(∀i,x i∈B) ∧ ramanujamPowerSum p s x=a := by
  rw [ramanujamPowerSubringOver,Subring.mem_map]
  constructor
  · rintro ⟨b,hb,he⟩
    obtain ⟨x,hx⟩ := (mem_ramanujamPowerSubring_iff (p:=p) s b).mp hb
    refine ⟨fun i => (x i:R),fun i => (x i).property,?_⟩
    calc
      ramanujamPowerSum p s (fun i => (x i:R))=
          B.subtype (ramanujamPowerSum p s x) := (map_ramanujamPowerSum B.subtype s x).symm
      _=B.subtype b := congrArg B.subtype hx
      _=a := he
  · rintro ⟨x,hx,he⟩
    let y : ℕ → B := fun i => ⟨x i,hx i⟩
    refine ⟨ramanujamPowerSum p s y,ramanujamPowerSum_mem s y,?_⟩
    rw [map_ramanujamPowerSum]
    exact he

theorem power_closure_le_ramanujamPowerSubringOver (n s : ℕ) :
    AddSubgroup.closure (Set.range (fun x : R => x^(n*p^s)))≤
      (ramanujamPowerSubringOver p s (Subring.closure (Set.range (fun x : R => x^n)))).toAddSubgroup := by
  apply (AddSubgroup.closure_le _).mpr
  rintro a ⟨x,rfl⟩
  let B := Subring.closure (Set.range (fun x : R => x^n))
  let y : B := ⟨x^n,Subring.subset_closure ⟨x,rfl⟩⟩
  refine ⟨y^(p^s),prime_power_mem_ramanujamPowerSubring s y,?_⟩
  change (x^n)^(p^s)=x^(n*p^s)
  rw [pow_mul]

theorem eligible_composite_truncated_expression (n s : ℕ) (a : R)
    (ha : a∈AddSubgroup.closure (Set.range (fun x : R => x^(n*p^s)))) :
    ∃x : ℕ → R,(∀i,x i∈Subring.closure (Set.range (fun y : R => y^n))) ∧
      ramanujamPowerSum p s x=a :=
  (mem_ramanujamPowerSubringOver_iff s _ a).mp
    (power_closure_le_ramanujamPowerSubringOver n s ha)

theorem eligible_composite_finite_truncated_expression (n s : ℕ) (a : R)
    (ha : a∈AddSubgroup.closure (Set.range (fun x : R => x^(n*p^s)))) :
    ∃x : Fin (s+1) → R,(∀i,x i∈Subring.closure (Set.range (fun y : R => y^n))) ∧
      ramanujamPowerTuple p s x=a := by
  obtain ⟨x,hx,he⟩ := eligible_composite_truncated_expression (p:=p) n s a ha
  exact ⟨fun i => x i,fun i => hx i,(ramanujamPowerTuple_restrict s x).trans he⟩

#print axioms mem_ramanujamPowerSubringOver_iff
#print axioms power_closure_le_ramanujamPowerSubringOver
#print axioms eligible_composite_finite_truncated_expression
end WaringSiegel.WSL4
