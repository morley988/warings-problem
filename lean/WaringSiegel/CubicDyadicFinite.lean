import WaringSiegel.CubicAlgebra
import Mathlib.GroupTheory.Index

/-!
# Four cubes over finite fields of characteristic two

Every element of the additive subgroup generated by cubes in a finite field of
characteristic two is a sum of four cubes with a nonzero coordinate.  The proof
uses the Artin–Schreier map `t ↦ t² + t`: its kernel has two elements, so its
image has index two.  Its values are sums of three cubes by an explicit identity.
No character-sum bound or estimate for algebraic curves is assumed.
-/

namespace WaringSiegel

open scoped BigOperators CharTwo

section ArtinSchreier

variable (F : Type*) [CommRing F] [CharP F 2]

/-- The additive Artin–Schreier map in characteristic two. -/
def artinSchreier : F →+ F where
  toFun t := t ^ 2 + t
  map_zero' := by simp
  map_add' x y := by rw [CharTwo.add_sq]; ring

@[simp] theorem artinSchreier_apply (t : F) :
    artinSchreier F t = t ^ 2 + t := rfl

/-- Every Artin–Schreier value is a sum of three cubes, one of which is `1`. -/
theorem artinSchreier_three_cube_identity (t : F) :
    (t + 1) ^ 3 + t ^ 3 + 1 = artinSchreier F t := by
  simp only [artinSchreier_apply]
  ring_nf
  have h3 : (3 : F) = 1 := by
    calc
      (3 : F) = 2 + 1 := by norm_num
      _ = 1 := by rw [CharTwo.two_eq_zero, zero_add]
  simp [CharTwo.two_eq_zero, h3]

end ArtinSchreier

section FiniteField

variable (F : Type*) [Field F] [Finite F] [CharP F 2]

omit [Finite F] in
@[simp] theorem mem_artinSchreier_ker (t : F) :
    t ∈ (artinSchreier F).ker ↔ t = 0 ∨ t = 1 := by
  change t ^ 2 + t = 0 ↔ t = 0 ∨ t = 1
  rw [show t ^ 2 + t = t * (t + 1) by ring, mul_eq_zero, CharTwo.add_eq_zero]

omit [Finite F] in
/-- Over a field, the kernel consists exactly of `0` and `1`. -/
theorem artinSchreier_ker_card : Nat.card (artinSchreier F).ker = 2 := by
  apply Nat.card_eq_two_iff.mpr
  refine ⟨⟨0, by simp⟩, ⟨1, by simp⟩, ?_, ?_⟩
  · intro h
    exact zero_ne_one (congrArg Subtype.val h)
  · ext t
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
    rcases (mem_artinSchreier_ker F t).mp t.property with h | h
    · exact Or.inl (Subtype.ext h)
    · exact Or.inr (Subtype.ext h)

/-- Finiteness turns the two-element kernel into an index-two image. -/
theorem artinSchreier_range_index : (artinSchreier F).range.index = 2 := by
  rw [AddSubgroup.index_range, artinSchreier_ker_card]

/-- Two elements outside the Artin–Schreier image have sum in the image. -/
theorem add_mem_artinSchreier_range_of_not_mem {a b : F}
    (ha : a ∉ (artinSchreier F).range) (hb : b ∉ (artinSchreier F).range) :
    a + b ∈ (artinSchreier F).range := by
  obtain ⟨c, hc⟩ := AddSubgroup.index_eq_two_iff.mp (artinSchreier_range_index F)
  have h := (artinSchreier F).range.add_mem
    ((hc a).or.resolve_right ha) ((hc b).or.resolve_right hb)
  have heq : (a + c) + (b + c) = a + b := by
    calc
      (a + c) + (b + c) = a + b + (c + c) := by ring
      _ = a + b := by simp
  rwa [heq] at h

/-- Cubic eligibility supplies a cube in whichever Artin–Schreier coset is needed. -/
theorem exists_cube_artinSchreier_decomposition {a : F} (ha : a ∈ cubeSpan F) :
    ∃ b t : F, a = b ^ 3 + artinSchreier F t := by
  let A := (artinSchreier F).range
  have hcoset : ∃ b : F, a + b ^ 3 ∈ A := by
    by_cases haA : a ∈ A
    · exact ⟨0, by simpa using haA⟩
    · have hnot : ¬ ∀ b : F, b ^ 3 ∈ A := by
        intro hb
        have hle : cubeSpan F ≤ A := by
          apply (AddSubgroup.closure_le A).mpr
          rintro x ⟨b, rfl⟩
          exact hb b
        exact haA (hle ha)
      obtain ⟨b, hb⟩ := not_forall.mp hnot
      exact ⟨b, add_mem_artinSchreier_range_of_not_mem F haA hb⟩
  obtain ⟨b, t, ht⟩ := hcoset
  refine ⟨b, t, ?_⟩
  rw [ht]
  simp [add_left_comm]

/-- Every eligible element is four cubes, with the fourth coordinate equal to `1`. -/
theorem four_cubes_finite_char_two {a : F} (ha : a ∈ cubeSpan F) :
    ∃ x : Fin 4 → F, (∑ i, x i ^ 3) = a ∧ x 3 = 1 := by
  obtain ⟨b, t, ht⟩ := exists_cube_artinSchreier_decomposition F ha
  refine ⟨![b, t + 1, t, 1], ?_, rfl⟩
  simp only [Fin.sum_univ_succ, Matrix.cons_val_zero, Matrix.cons_val_succ,
    Fin.sum_univ_zero, add_zero, one_pow]
  rw [← artinSchreier_three_cube_identity F t] at ht
  simpa only [add_assoc] using ht.symm

/-- The representation has a nonzero coordinate, as needed for nonsingular lifting. -/
theorem four_cubes_finite_char_two_nonzero {a : F} (ha : a ∈ cubeSpan F) :
    ∃ x : Fin 4 → F, (∑ i, x i ^ 3) = a ∧ ∃ i, x i ≠ 0 := by
  obtain ⟨x, hx, hlast⟩ := four_cubes_finite_char_two F ha
  exact ⟨x, hx, 3, by rw [hlast]; exact one_ne_zero⟩

end FiniteField

end WaringSiegel

#print axioms WaringSiegel.four_cubes_finite_char_two
#print axioms WaringSiegel.four_cubes_finite_char_two_nonzero
