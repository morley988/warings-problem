import WaringSiegel.WSL3PoissonUniformTrace
import WaringSiegel.WSL2MomentCubicWeyl

/-!
# Actual translated and double-translated compact smooth amplitudes

These are precisely the weights generated by Weyl differencing. Their joint
smoothness and common compact support are proved, so all Fourier constants
are uniform while the normalized shifts stay in a fixed compact set.
-/

noncomputable section
open MeasureTheory Module Function NumberField NumberField.mixedEmbedding WaringSiegel.WSL2
open scoped ContDiff BigOperators Classical NumberField ComplexConjugate
namespace WaringSiegel.WSL3Poisson
variable {K : Type*} [Field K] [NumberField K]

def translatedProductWeight (w : mixedSpace K → ℂ) : mixedSpace K × mixedSpace K → ℂ :=
  fun p => w (p.2+p.1) * conj (w p.2)

def doubleTranslatedProductWeight (w : mixedSpace K → ℂ) :
    (mixedSpace K × mixedSpace K) × mixedSpace K → ℂ :=
  fun p => (w (p.2+p.1.2+p.1.1) * conj (w (p.2+p.1.2))) *
    conj (w (p.2+p.1.1) * conj (w p.2))

theorem translatedProductWeight_contDiff {w : mixedSpace K → ℂ} (hw : ContDiff ℝ ∞ w) :
    ContDiff ℝ ∞ (translatedProductWeight w) := by
  exact (hw.comp (contDiff_snd.add contDiff_fst)).mul
    (Complex.conjCLE.contDiff.comp (hw.comp contDiff_snd))

theorem doubleTranslatedProductWeight_contDiff {w : mixedSpace K → ℂ} (hw : ContDiff ℝ ∞ w) :
    ContDiff ℝ ∞ (doubleTranslatedProductWeight w) := by
  have hh : ContDiff ℝ ∞ (fun p : (mixedSpace K × mixedSpace K) × mixedSpace K => p.2+p.1.1) :=
    contDiff_snd.add (contDiff_fst.comp contDiff_fst)
  have hj : ContDiff ℝ ∞ (fun p : (mixedSpace K × mixedSpace K) × mixedSpace K => p.2+p.1.2) :=
    contDiff_snd.add (contDiff_snd.comp contDiff_fst)
  have hjh : ContDiff ℝ ∞ (fun p : (mixedSpace K × mixedSpace K) × mixedSpace K => p.2+p.1.2+p.1.1) :=
    hj.add (contDiff_fst.comp contDiff_fst)
  exact ((hw.comp hjh).mul (Complex.conjCLE.contDiff.comp (hw.comp hj))).mul
    (Complex.conjCLE.contDiff.comp ((hw.comp hh).mul (Complex.conjCLE.contDiff.comp (hw.comp contDiff_snd))))

theorem translatedProductWeight_support {w : mixedSpace K → ℂ} (a : mixedSpace K) :
    support (fun x => translatedProductWeight w (a,x)) ⊆ support w := by
  intro x hx
  have h := (mul_ne_zero_iff.mp hx).2
  exact fun hz => h (by rw [hz, map_zero])

theorem doubleTranslatedProductWeight_support {w : mixedSpace K → ℂ} (a : mixedSpace K × mixedSpace K) :
    support (fun x => doubleTranslatedProductWeight w (a,x)) ⊆ support w := by
  intro x hx
  intro hz
  apply hx
  simp only [doubleTranslatedProductWeight, hz, map_zero, mul_zero]

theorem translatedProductWeight_uniform_Fourier {w : mixedSpace K → ℂ}
    (hw : ContDiff ℝ ∞ w) (hc : HasCompactSupport w) (L : ℝ) (m : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ a : mixedSpace K, ‖a‖ ≤ L → ∀ β : mixedSpace K,
      ‖traceFourier (fun x => translatedProductWeight w (a,x)) β‖ ≤
        C * archimedeanProductDecay m β := by
  obtain ⟨C, hC, hb⟩ := uniform_traceFourier_product_decay
    (translatedProductWeight_contDiff hw) (isCompact_closedBall (0:mixedSpace K) L) hc
    (fun a => (translatedProductWeight_support a).trans subset_closure) m
  exact ⟨C, hC, fun a ha β => hb a (by simpa only [Metric.mem_closedBall, dist_zero_right] using ha) β⟩

theorem doubleTranslatedProductWeight_uniform_Fourier {w : mixedSpace K → ℂ}
    (hw : ContDiff ℝ ∞ w) (hc : HasCompactSupport w) (L : ℝ) (m : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ a : mixedSpace K × mixedSpace K, ‖a‖ ≤ L → ∀ β : mixedSpace K,
      ‖traceFourier (fun x => doubleTranslatedProductWeight w (a,x)) β‖ ≤
        C * archimedeanProductDecay m β := by
  obtain ⟨C, hC, hb⟩ := uniform_traceFourier_product_decay
    (doubleTranslatedProductWeight_contDiff hw) (isCompact_closedBall (0:mixedSpace K × mixedSpace K) L) hc
    (fun a => (doubleTranslatedProductWeight_support a).trans subset_closure) m
  exact ⟨C, hC, fun a ha β => hb a (by simpa only [Metric.mem_closedBall, dist_zero_right] using ha) β⟩

end WaringSiegel.WSL3Poisson
