import WaringSiegel.WSL4ArchFiniteFieldSubring

/-! # Every element is a short power sum in a sufficiently large finite field

If q>(n-1)^2, the subring generated by nth powers cannot be proper.
The existing shortest-prefix theorem then gives at most n actual powers.
-/
noncomputable section
namespace WaringSiegel.WSL4
set_option maxHeartbeats 1400000
variable {F : Type*} [Field F] [Finite F]

theorem finiteField_powerGeneratedRing_eq_top (n : ℕ) (hn : 0<n)
    (hq : (n-1)^2<Nat.card F) : WSL4Local.powerGeneratedRing n F=⊤ := by
  let S := WSL4Local.powerGeneratedRing n F
  letI : Fintype S := Fintype.ofFinite S
  by_contra hS
  have hs : 1<Nat.card S := by
    simpa only [Nat.card_eq_fintype_card] using (Fintype.one_lt_card (α:=S))
  have hqpos : 0<Nat.card F := Nat.card_pos
  have hsquare : Nat.card S^2≤Nat.card F := finiteField_proper_subring_card_sq_le S hS
  have hcount : Nat.card F-1≤n*(Nat.card S-1) :=
    finiteField_card_le_power_subring_card n hn S
      (fun x => Subring.subset_closure ⟨x,rfl⟩)
  have hcount' : Nat.card F≤n*(Nat.card S-1)+1 := by omega
  have hsplus : Nat.card S+1≤n := by
    by_contra hnot
    have hnle : n≤Nat.card S := by omega
    have hmul := Nat.mul_le_mul_right (Nat.card S-1) hnle
    have hsub : Nat.card S-1+1=Nat.card S := by omega
    nlinarith
  have hsub : Nat.card S-1≤n-2 := by omega
  have hcount'' : Nat.card F≤n*(n-2)+1 :=
    hcount'.trans (Nat.add_le_add_right (Nat.mul_le_mul_left n hsub) 1)
  have hnsub1 : n-1+1=n := by omega
  have hnsub2 : n-2+2=n := by omega
  nlinarith

theorem finiteField_mem_power_closure_of_card_large (n : ℕ) (hn : 0<n)
    (hq : (n-1)^2<Nat.card F) (a : F) :
    a∈AddSubgroup.closure (Set.range (fun x : F => x^n)) := by
  rw [← WSL4Local.mem_powerGeneratedRing_iff]
  rw [finiteField_powerGeneratedRing_eq_top n hn hq]
  exact Subring.mem_top a

theorem finiteField_short_power_list_of_card_large (n : ℕ) (hn : 0<n)
    (hq : (n-1)^2<Nat.card F) (a : F) :
    ∃l : List F,l.length≤n ∧ localPowerListSum n l=a :=
  finiteField_power_list n hn a (finiteField_mem_power_closure_of_card_large n hn hq a)

#print axioms finiteField_powerGeneratedRing_eq_top
#print axioms finiteField_mem_power_closure_of_card_large
#print axioms finiteField_short_power_list_of_card_large
end WaringSiegel.WSL4
