import WaringSiegel.WSL3PoissonSchwartz
import Mathlib.MeasureTheory.Measure.Haar.NormedSpace

/-!
# Poisson summation with geometric covolume normalization

A real basis parametrizes its actual integer lattice. The normalization below
is the Lebesgue volume of its half-open fundamental parallelepiped. It is
computed from measure transport, not assumed as a coefficient identity.
-/

noncomputable section
open MeasureTheory MeasureTheory.Measure Module Topology TopologicalSpace
open scoped BigOperators Classical SchwartzMap
namespace WaringSiegel.WSL3Poisson
variable {ι : Type*} [Fintype ι]
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasureSpace E] [BorelSpace E]
  [IsAddHaarMeasure (volume : Measure E)]

/-- Actual volume of the half-open lattice fundamental parallelepiped. -/
def basisCovolume (b : Basis ι ℝ E) : ℝ :=
  volume.real (ZSpan.fundamentalDomain b)

theorem basisCovolume_pos (b : Basis ι ℝ E) : 0 < basisCovolume b :=
  ENNReal.toReal_pos (ZSpan.measure_fundamentalDomain_ne_zero b)
    (ZSpan.fundamentalDomain_isBounded b).measure_lt_top.ne

/-- Coordinates send the fundamental domain precisely to the unit cube. -/
theorem basis_preimage_fundamentalDomain (b : Basis ι ℝ E) :
    b.equivFunL.symm ⁻¹' ZSpan.fundamentalDomain b = unitCube := by
  ext x
  change (∀ i, b.repr (b.equivFunL.symm x) i ∈ Set.Ico (0:ℝ) 1) ↔ _
  change (∀ i, (b.equivFun (b.equivFun.symm x)) i ∈ Set.Ico (0:ℝ) 1) ↔ _
  rw [LinearEquiv.apply_symm_apply]
  simp only [unitCube, Set.mem_univ_pi]

/-- The pushed-forward coordinate volume gives the fundamental domain volume one. -/
theorem basis_map_volume_fundamentalDomain (b : Basis ι ℝ E) :
    Measure.map b.equivFunL.symm volume (ZSpan.fundamentalDomain b) = 1 := by
  rw [Measure.map_apply b.equivFunL.symm.continuous.measurable
    (ZSpan.fundamentalDomain_measurableSet b), basis_preimage_fundamentalDomain]
  simp only [unitCube, volume_pi, Measure.pi_pi, Real.volume_Ico,
    sub_zero, ENNReal.ofReal_one, Finset.prod_const_one]

/-- The actual basis covolume is the Jacobian normalizing coordinate volume. -/
theorem basis_map_volume (b : Basis ι ℝ E) :
    Measure.map b.equivFunL.symm volume =
      ENNReal.ofReal (basisCovolume b)⁻¹ • volume := by
  have h0 := ZSpan.measure_fundamentalDomain_ne_zero b (μ:=volume)
  have ht : volume (ZSpan.fundamentalDomain b) ≠ ⊤ :=
    (ZSpan.fundamentalDomain_isBounded b).measure_lt_top.ne
  have h := MeasureTheory.measure_eq_sub_vadd
    (Measure.map b.equivFunL.symm volume) volume h0 ht
  rw [basis_map_volume_fundamentalDomain, one_div] at h
  convert h using 2
  rw [ENNReal.ofReal_inv_of_pos (basisCovolume_pos b),
    basisCovolume, measureReal_def, ENNReal.ofReal_toReal ht]

/-- Change of variables with the proved geometric covolume factor. -/
theorem basis_integral_comp (b : Basis ι ℝ E) (f : E → ℂ) :
    (∫ x : ι → ℝ, f (b.equivFunL.symm x)) =
      (basisCovolume b)⁻¹ • (∫ y, f y) := by
  have h := integral_map_equiv (μ:=volume)
    b.equivFunL.symm.toHomeomorph.toMeasurableEquiv f
  change (∫ y, f y ∂Measure.map b.equivFunL.symm volume) =
    (∫ x : ι → ℝ, f (b.equivFunL.symm x)) at h
  rw [basis_map_volume, integral_smul_measure,
    ENNReal.toReal_ofReal (inv_nonneg.mpr (basisCovolume_pos b).le)] at h
  exact h.symm

/-- The dual lattice character in basis coordinates, integrated against the
original physical-space function. -/
def basisFourier (b : Basis ι ℝ E) (f : E → ℂ) (n : ι → ℤ) : ℂ :=
  ∫ x, integerCharacter (-n) (b.equivFunL x) * f x

/-- Actual coefficient computation, including the covolume normalization. -/
theorem integerFourier_basis_comp (b : Basis ι ℝ E) (f : E → ℂ) (n : ι → ℤ) :
    integerFourier (fun x => f (b.equivFunL.symm x)) n =
      (basisCovolume b)⁻¹ • basisFourier b f n := by
  have h := basis_integral_comp b (fun x => integerCharacter (-n) (b.equivFunL x)*f x)
  simpa only [ContinuousLinearEquiv.apply_symm_apply] using h

/-- Poisson summation for the actual lattice generated by any real basis. -/
theorem poisson_basis_schwartz (b : Basis ι ℝ E) (f : 𝓢(E, ℂ)) :
    (∑' n : ι → ℤ, f (b.equivFunL.symm (intVector n))) =
      (basisCovolume b)⁻¹ • (∑' n : ι → ℤ, basisFourier b f n) := by
  let g : 𝓢((ι → ℝ), ℂ) := SchwartzMap.compCLMOfContinuousLinearEquiv ℂ b.equivFunL.symm f
  have h := poisson_schwartz_zero g
  change (∑' n : ι → ℤ, f (b.equivFunL.symm (intVector n))) =
    ∑' n : ι → ℤ, integerFourier (fun x => f (b.equivFunL.symm x)) n at h
  simp_rw [integerFourier_basis_comp] at h
  rw [tsum_const_smul''] at h
  exact h

end WaringSiegel.WSL3Poisson
