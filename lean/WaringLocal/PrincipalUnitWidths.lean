import WaringLocal.FinitePrecision

/-! Finite-precision comparison of ordinary and primitive power representations.
The two ideals may, for example, be consecutive levels in a valuation ring.
All roots and sums are actual elements of the commutative ring. -/
namespace WaringLocal.FinitePrecision
open scoped BigOperators

variable {R : Type*} [CommRing R]

/-- Moving a single unit root fills its entire coset to a prescribed
precision, provided every principal unit of that precision is a kth power. -/
theorem move_unit (I : Ideal R) (k : ℕ)
    (hlift : ∀ t ∈ I, ∃ v : Rˣ, (v : R)^k = 1 + t)
    (u : Rˣ) {d : R} (hd : d ∈ I) :
    ∃ y : Rˣ, (y : R)^k = (u : R)^k + d := by
  let w : R := (↑(u⁻¹) : R)^k
  obtain ⟨v,hv⟩ := hlift (w*d) (I.mul_mem_left _ hd)
  refine ⟨u*v, ?_⟩
  have hcancel : (u : R)^k * w = 1 := by
    simp [w, ← mul_pow]
  change ((u : R) * (v : R))^k = _
  rw [mul_pow,hv,mul_add,mul_one,← mul_assoc,hcancel,one_mul]

/-- Surjectivity on the principal units also shows that every element of
the precision ideal is in the additive subgroup generated by powers. -/
theorem precision_le_eligible (I : Ideal R) (k : ℕ)
    (hlift : ∀ t ∈ I, ∃ v : Rˣ, (v : R)^k = 1 + t) {t : R} (ht : t ∈ I) :
    t ∈ Eligible k := by
  obtain ⟨v, hv⟩ := hlift t ht
  have hm : (↑v : R)^k ∈ Eligible k := AddSubgroup.subset_closure ⟨v, rfl⟩
  have ho : (1 : R)^k ∈ Eligible k := AddSubgroup.subset_closure ⟨1, rfl⟩
  simpa [hv] using (Eligible (R := R) k).sub_mem hm ho

/-- If nonunit powers land strictly deeper than the principal-unit lifting
precision, the ordinary and primitive local Waring bounds agree at every s. -/
theorem widths_agree_of_principal_unit_powers (I D : Ideal R) (k s : ℕ)
    (hDI : D < I)
    (hlift : ∀ t ∈ I, ∃ v : Rˣ, (v : R)^k = 1 + t)
    (hdeep : ∀ x : R, ¬ IsUnit x → x^k ∈ D) :
    (∀ z : R, z ∈ Eligible k → Ordinary k s z) ↔
      (∀ z : R, z ∈ Eligible k → Primitive k s z) := by
  obtain ⟨t, htI, htD⟩ := SetLike.exists_of_lt hDI
  apply widths_agree I D k s hDI.le hdeep _ t
    (precision_le_eligible I k hlift htI) htI htD
  intro x b hx hb
  obtain ⟨u, rfl⟩ := hx
  obtain ⟨v, hv⟩ := move_unit I k hlift u hb
  exact ⟨v, v.isUnit, hv⟩

#print axioms widths_agree_of_principal_unit_powers
end WaringLocal.FinitePrecision
