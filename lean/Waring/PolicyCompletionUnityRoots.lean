import Waring.PolicyCompletionRoots
import Mathlib.RingTheory.ZMod.UnitsCyclic
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.GroupTheory.Coset.Card

/-!
# Uniform roots of unity over composite moduli

This is the arithmetic root-count input to the coprime difference quotient
in Vaughan--Wooley (1995), equation (4.8).  Unlike a nonsingular-root bound,
it also includes primes dividing the exponent.  Odd prime-power units are
cyclic; at powers of two the cyclic subgroup generated by five has index
two.  Prime-power reduction and the proved divisor estimate then give a
uniform arbitrary small power bound.
-/

noncomputable section
open scoped BigOperators
open scoped Classical

namespace Waring.PolicyCompletionUnityRoots
open PolicyCompletionRoots AuxiliaryL2Grouping

/-- Each coset of a cyclic subgroup contains at most d solutions of x^d=1.
The ambient group is commutative so translation preserves equal powers. -/
theorem cyclic_coset_roots_card_le {G : Type*} [CommGroup G] [Fintype G]
    [DecidableEq G] (H : Subgroup G) [IsCyclic H]
    {d : ℕ} (hd : 0 < d) (q : G ⧸ H) :
    ((Finset.univ.filter fun x : G => x^d=1).filter
      fun x => (QuotientGroup.mk x : G ⧸ H)=q).card ≤ d := by
  classical
  let S := (Finset.univ.filter fun x : G => x^d=1).filter
    fun x => (QuotientGroup.mk x : G ⧸ H)=q
  by_cases hS : S.Nonempty
  · obtain ⟨a,ha⟩ := hS
    have haPow : a^d=1 := (Finset.mem_filter.mp (Finset.mem_filter.mp ha).1).2
    have haq : (QuotientGroup.mk a : G ⧸ H)=q := (Finset.mem_filter.mp ha).2
    have hmem (x : G) (hx : x∈S) : a⁻¹*x∈H := by
      apply QuotientGroup.eq.mp
      exact haq.trans (Finset.mem_filter.mp hx).2.symm
    let f : S → H := fun x => ⟨a⁻¹*x.val,hmem x.val x.property⟩
    have hf : Function.Injective f := by
      intro x y hxy
      apply Subtype.ext
      have hh := congrArg Subtype.val hxy
      exact mul_left_cancel hh
    have hpow (x : S) : (f x)^d=1 := by
      apply Subtype.ext
      change (a⁻¹*x.val)^d=1
      rw [mul_pow,inv_pow,haPow,inv_one,one_mul]
      exact (Finset.mem_filter.mp (Finset.mem_filter.mp x.property).1).2
    calc
      S.card = Fintype.card S := (Fintype.card_coe S).symm
      _ ≤ (Finset.univ.filter fun x : H => x^d=1).card := by
        simpa only [Fintype.card_coe] using Fintype.card_le_of_injective
          (fun x : S => (⟨f x,Finset.mem_filter.mpr ⟨Finset.mem_univ _,hpow x⟩⟩ :
            {x // x∈Finset.univ.filter fun x : H => x^d=1}))
          (fun x y hxy => hf (congrArg Subtype.val hxy))
      _ ≤ d := IsCyclic.card_pow_eq_one_le hd
  · have hz : S=∅ := Finset.not_nonempty_iff_eq_empty.mp hS
    change S.card≤d
    rw [hz,Finset.card_empty]
    exact Nat.zero_le _

/-- A cyclic subgroup of index r bounds all d-th roots by r*d. -/
theorem roots_card_le_cyclic_index {G : Type*} [CommGroup G] [Fintype G]
    [DecidableEq G] (H : Subgroup G) [IsCyclic H]
    {d : ℕ} (hd : 0 < d) :
    (Finset.univ.filter fun x : G => x^d=1).card ≤ Nat.card (G ⧸ H)*d := by
  classical
  letI : Fintype (G ⧸ H) := Fintype.ofFinite _
  let S := Finset.univ.filter fun x : G => x^d=1
  have hm : ∀x∈S, (QuotientGroup.mk x : G ⧸ H)∈Finset.univ := by simp
  rw [Finset.card_eq_sum_card_fiberwise hm]
  calc
    _ ≤ ∑ _q : G ⧸ H, d := Finset.sum_le_sum
      (fun q _ => cyclic_coset_roots_card_le H hd q)
    _ = _ := by simp [Nat.card_eq_fintype_card]

/-- At a power of two, the subgroup generated by five has index two. -/
theorem five_subgroup_quotient_card (n : ℕ) :
    ∃ u : (ZMod (2^(n+2)))ˣ,
      Nat.card ((ZMod (2^(n+2)))ˣ ⧸ Subgroup.zpowers u)=2 := by
  have hu : IsUnit (5 : ZMod (2^(n+2))) := by
    change IsUnit ((5 : ℕ) : ZMod (2^(n+2)))
    rw [ZMod.isUnit_iff_coprime]
    exact (by decide : Nat.Coprime 5 2).pow_right _
  let u := hu.unit
  have ho : orderOf u=2^n := by
    rw [← orderOf_injective _ Units.coeHom_injective u,Units.coeHom_apply]
    change orderOf (↑hu.unit : ZMod (2^(n+2)))=2^n
    rw [hu.unit_spec]
    exact ZMod.orderOf_five n
  refine ⟨u,?_⟩
  have hmul := Subgroup.card_eq_card_quotient_mul_card_subgroup (Subgroup.zpowers u)
  have htot : (2^(n+2)).totient=2^(n+1) := by
    rw [show n+2=(n+1)+1 by omega,Nat.totient_prime_pow_succ Nat.prime_two]
    norm_num
  rw [Nat.card_zpowers,ho,Nat.card_eq_fintype_card,ZMod.card_units_eq_totient,htot] at hmul
  have hpos : 0 < 2^n := pow_pos (by norm_num) _
  have hp : 2^(n+1)=2*2^n := by rw [pow_succ]; omega
  rw [hp] at hmul
  exact Nat.eq_of_mul_eq_mul_right hpos hmul.symm

/-- All prime powers, including the singular primes of the exponent. -/
theorem prime_power_unity_card_le {d p : ℕ} (hd : 0 < d) (hp : p.Prime) (e : ℕ)
    [NeZero (p^e)] :
    (Finset.univ.filter fun x : (ZMod (p^e))ˣ => x^d=1).card ≤ 2*d := by
  classical
  haveI : NeZero (p^e) := ⟨pow_ne_zero _ hp.ne_zero⟩
  by_cases hp2 : p=2
  · subst p
    by_cases he : e≤1
    · have hcard : (Finset.univ.filter fun x : (ZMod (2^e))ˣ => x^d=1).card ≤ 2 := by
        apply (Finset.card_filter_le _ _).trans
        rw [Finset.card_univ,ZMod.card_units_eq_totient]
        exact (Nat.totient_le _).trans (by
          exact (Nat.pow_le_pow_right (by norm_num) he).trans_eq (by norm_num))
      omega
    · obtain ⟨n,rfl⟩ : ∃n,e=n+2 := ⟨e-2,by omega⟩
      obtain ⟨u,hu⟩ := five_subgroup_quotient_card n
      letI : IsCyclic (Subgroup.zpowers u) :=
        (Subgroup.isCyclic_iff_exists_zpowers_eq_top _).mpr ⟨u,rfl⟩
      have hb := roots_card_le_cyclic_index (Subgroup.zpowers u) hd
      rwa [hu] at hb
  · letI : IsCyclic (ZMod (p^e))ˣ := ZMod.isCyclic_units_of_prime_pow p hp hp2 e
    exact (IsCyclic.card_pow_eq_one_le hd).trans (by omega)

/-- Canonical representatives of the d-th roots of unity modulo q. -/
def unityRoots (d q : ℕ) : Finset ℕ :=
  (Finset.range q).filter fun x => (x : ZMod q)^d=1

@[simp] theorem mem_unityRoots {d q x : ℕ} :
    x∈unityRoots d q ↔ x<q ∧ (x : ZMod q)^d=1 := by
  simp [unityRoots]

theorem unityRoots_prime_power_card_le {d p : ℕ} (hd : 0 < d)
    (hp : p.Prime) (e : ℕ) : (unityRoots d (p^e)).card ≤ 2*d := by
  classical
  letI : NeZero (p^e) := ⟨pow_ne_zero _ hp.ne_zero⟩
  let f : unityRoots d (p^e) → (ZMod (p^e))ˣ :=
    fun x => (IsUnit.of_pow_eq_one (mem_unityRoots.mp x.property).2 hd.ne').unit
  have hval (x : unityRoots d (p^e)) : ↑(f x)=(x.val : ZMod (p^e)) :=
    IsUnit.unit_spec _
  have hf : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    have hcast := congrArg (fun u : (ZMod (p^e))ˣ => (u : ZMod (p^e))) hxy
    change (↑(f x) : ZMod (p^e))=↑(f y) at hcast
    rw [hval,hval] at hcast
    have hmod := (ZMod.natCast_eq_natCast_iff' x.val y.val _).mp hcast
    simpa only [Nat.mod_eq_of_lt (mem_unityRoots.mp x.property).1,
      Nat.mod_eq_of_lt (mem_unityRoots.mp y.property).1] using hmod
  have hpow (x : unityRoots d (p^e)) : (f x)^d=1 := by
    apply Units.ext
    simpa only [Units.val_pow_eq_pow_val,Units.val_one,hval] using (mem_unityRoots.mp x.property).2
  calc
    _ = Fintype.card (unityRoots d (p^e)) := (Fintype.card_coe _).symm
    _ ≤ (Finset.univ.filter fun x : (ZMod (p^e))ˣ => x^d=1).card := by
      simpa only [Fintype.card_coe] using Fintype.card_le_of_injective
        (fun x : unityRoots d (p^e) => (⟨f x,
          Finset.mem_filter.mpr ⟨Finset.mem_univ _,hpow x⟩⟩ :
          {x // x∈Finset.univ.filter fun x : (ZMod (p^e))ˣ => x^d=1}))
        (fun x y hxy => hf (congrArg Subtype.val hxy))
    _ ≤ 2*d := prime_power_unity_card_le hd hp e

theorem unity_root_reduction {d q m x : ℕ} (hm : 0 < m) (hmq : m∣q)
    (hx : x∈unityRoots d q) : x%m∈unityRoots d m := by
  apply mem_unityRoots.mpr
  refine ⟨Nat.mod_lt _ hm,?_⟩
  have h := congrArg (ZMod.castHom hmq (ZMod m)) (mem_unityRoots.mp hx).2
  simpa only [map_pow,map_natCast,map_one,ZMod.natCast_mod] using h

/-- Complete prime-power reductions distinguish representatives in [0,q). -/
theorem prime_power_reduction_injective {q : ℕ} (hq : 0 < q) :
    Set.InjOn (fun x : ℕ => fun p : q.primeFactors =>
      x%(p.val^q.factorization p.val)) (Finset.range q) := by
  intro x hx y hy hxy
  have hxlt := Finset.mem_range.mp hx
  have hylt := Finset.mem_range.mp hy
  have hqdiv : (q : ℤ)∣(y : ℤ)-x := by
    apply Int.natCast_dvd.mpr
    apply (Nat.dvd_iff_prime_pow_dvd_dvd _ _).mpr
    intro p e hp hpeq
    by_cases he : e=0
    · simp [he]
    have hpdq : p∣q := (dvd_pow_self p he).trans hpeq
    have hmem : p∈q.primeFactors := Nat.mem_primeFactors.mpr ⟨hp,hpdq,hq.ne'⟩
    have hefac : e≤q.factorization p := (hp.pow_dvd_iff_le_factorization hq.ne').mp hpeq
    have hmod := congrFun hxy ⟨p,hmem⟩
    have hzmod : (x : ZMod (p^q.factorization p))=(y : ZMod (p^q.factorization p)) :=
      (ZMod.natCast_eq_natCast_iff' x y _).mpr hmod
    have hfull : ((p^q.factorization p : ℕ) : ℤ)∣(y : ℤ)-x :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub (x : ℤ) (y : ℤ) _).mp
        (by simpa only [Int.cast_natCast] using hzmod)
    apply Int.natCast_dvd.mp
    exact (show ((p^e : ℕ) : ℤ)∣((p^q.factorization p : ℕ) : ℤ) by
      exact_mod_cast pow_dvd_pow p hefac).trans hfull
  have hzmod : (x : ZMod q)=(y : ZMod q) := by
    simpa only [Int.cast_natCast] using
      (ZMod.intCast_eq_intCast_iff_dvd_sub (x : ℤ) (y : ℤ) q).mpr hqdiv
  have hmod := (ZMod.natCast_eq_natCast_iff' x y q).mp hzmod
  simpa only [Nat.mod_eq_of_lt hxlt,Nat.mod_eq_of_lt hylt] using hmod

/-- The actual composite root set has a divisor-power bound. -/
theorem unityRoots_card_le_divisor_power {d q : ℕ} (hd : 0 < d) (hq : 0 < q) :
    (unityRoots d q).card ≤ q.divisors.card^(2*d) := by
  classical
  let roots := Fintype.piFinset
    (fun p : q.primeFactors => unityRoots d (p.val^q.factorization p.val))
  have hc : (unityRoots d q).card≤roots.card := by
    apply Finset.card_le_card_of_injOn
      (fun x : ℕ => fun p : q.primeFactors => x%(p.val^q.factorization p.val))
    · intro x hx
      apply Fintype.mem_piFinset.mpr
      intro p
      have hp := Nat.prime_of_mem_primeFactors p.property
      exact unity_root_reduction (pow_pos hp.pos _)
        ((hp.pow_dvd_iff_le_factorization hq.ne').mpr le_rfl) hx
    · exact (prime_power_reduction_injective hq).mono (Finset.filter_subset _ _)
  calc
    _ ≤ roots.card := hc
    _ = ∏ p : q.primeFactors, (unityRoots d (p.val^q.factorization p.val)).card :=
      Fintype.card_piFinset _
    _ ≤ ∏ _p : q.primeFactors, 2*d := by
      apply Finset.prod_le_prod (fun _ _ => Nat.zero_le _)
      intro p hp
      exact unityRoots_prime_power_card_le hd (Nat.prime_of_mem_primeFactors p.property) _
    _ = (2*d)^q.primeFactors.card := by simp
    _ ≤ (2^(2*d))^q.primeFactors.card :=
      Nat.pow_le_pow_left (Nat.lt_two_pow_self.le) _
    _ = (2^q.primeFactors.card)^(2*d) := by rw [← pow_mul,← pow_mul,Nat.mul_comm]
    _ ≤ q.divisors.card^(2*d) :=
      Nat.pow_le_pow_left (two_pow_primeFactors_card_le_divisors hq) _

/-- Uniform arbitrary small power bound, with every singular prime included. -/
theorem unityRoots_card_le_rpow {d : ℕ} (hd : 0 < d) {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0<C ∧ ∀ q : ℕ, 0<q →
      ((unityRoots d q).card : ℝ)≤C*(q : ℝ)^ε := by
  obtain ⟨C,hC,hdiv⟩ := divisor_power_le_rpow (2*d) hε
  refine ⟨C,hC,?_⟩
  intro q hq
  exact (show ((unityRoots d q).card : ℝ)≤(q.divisors.card : ℝ)^(2*d) by
    exact_mod_cast unityRoots_card_le_divisor_power hd hq).trans (hdiv q hq)

#print axioms prime_power_unity_card_le
#print axioms unityRoots_card_le_divisor_power
#print axioms unityRoots_card_le_rpow
end Waring.PolicyCompletionUnityRoots
