def entryOK (e : Entry) : Bool :=
  let w := decode 14 e.bits
  let p := pairOfWord w
  1 ≤ e.bits && e.bits < 2^15 && 0 < e.x && 0 < e.den &&
    p.x*e.den == e.x*p.denominator && p.y*e.den == e.y*p.denominator &&
    validWord w

theorem words_checked : words.size = 184 ∧ words.all entryOK = true := by
  decide +kernel

#print axioms words_checked
end WaringLimit
