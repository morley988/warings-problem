import WaringDualEnvelope.Words

/-! The 184 distinct words used by an explicit limiting menu. A word starts
at (1/2,1/2). Its binary representation stores A=0 and B=1 after an
initial sentinel. All numerators, denominators and degree exclusions are
checked against the previously defined arithmetic A/B transformations. -/
namespace WaringLimit
open WaringDualEnvelope

def decode : Nat → Nat → List Bool
  | 0, _ => []
  | fuel+1, bits => if bits ≤ 1 then [] else
      decode fuel (bits/2) ++ [bits%2 == 1]

structure Entry where
  bits : Nat
  x : Nat
  y : Nat
  den : Nat
deriving Repr, DecidableEq

