import WaringLimit.Coverage
import WaringDualEnvelope.ConductorPairs

/-! The strict margin in the limiting menu absorbs all of the
finite-degree radical losses uniformly. -/
noncomputable section
namespace WaringLimit
open WaringDualEnvelope

private def lossCheck (e : Entry) : Bool :=
  let p := pairOfWord (decode 14 e.bits)
  0<p.denominator && 0<p.lossDen && p.loss≤40*p.lossDen

private theorem losses_checked : words.all lossCheck = true := by
  set_option maxRecDepth 16000 in decide +kernel

private theorem T_pos : 0<T := by decide
attribute [local irreducible] T B F words

def FiniteCovered (k : Nat) (z : Nat) (θ u : ℝ) : Prop :=
  ∃ saving : ℝ, 2*(z:ℝ)/T < saving ∧
    ((∃ w : List Bool, SafeAt k (0,1) (1,0) w.reverse ∧
      saving ≤ 1-lambda (pairOfWord w)-kappa (pairOfWord w)*(u-1)
          -(1+radical (pairOfWord w))*θ) ∨
     WaringEnvelope.WeylBranch k θ u saving)

/-- This statement uses the actual degree, the actual radical parameter,
the actual rational pair generated by the A/B word and a *strict*
saving above twice the prescribed height. -/
theorem endpoint_stable {z code m k : Nat} (ok : endpoint z code = some m)
    (hk : 2*F+1≤k) {θ u : ℝ} (hn : 0≤θ) (ht : θ≤1/(2000*T))
    (hu : 1≤u) (hm : u≤(m:ℝ)/B) : FiniteCovered k z θ u := by
  obtain ⟨σ,hs,cover⟩ := endpoint_covers ok
  have hT : (0:ℝ)<T := by exact_mod_cast T_pos
  have hhalf : 0<1/(2*(T:ℝ)) := by positivity
  have h1 : 2*(z:ℝ)+1≤σ := by exact_mod_cast (Nat.succ_le_of_lt hs)
  let save := (2*(z:ℝ)+1/2)/T
  have hsave : 2*(z:ℝ)/T < save := by dsimp [save]; gcongr; linarith
  have hgap : save+1/(2*(T:ℝ))≤(σ:ℝ)/T := by
    dsimp [save]
    field_simp
    linarith only [h1]
  have htheta : 1000*θ≤1/(2*(T:ℝ)) := calc
    _ ≤ 1000*(1/(2000*(T:ℝ))) := mul_le_mul_of_nonneg_left ht (by norm_num)
    _ = _ := by field_simp; ring
  have hf : 2*F+1≤1000 := by decide +kernel
  refine ⟨save,hsave,?_⟩
  obtain ⟨e,emem,he,hpair⟩ | ⟨j,hj,hjk,hweyl⟩ := cover u hu hm
  · let w := decode 14 e.bits
    let p := pairOfWord w
    have hL := (Array.all_eq_true_iff_forall_mem.mp losses_checked) e emem
    simp only [lossCheck,Bool.and_eq_true,decide_eq_true_eq] at hL
    simp only [entryOK,Bool.and_eq_true,decide_eq_true_eq,beq_iff_eq] at he
    have hpd : (0:ℝ)<p.denominator := by exact_mod_cast hL.1.1
    have hld : (0:ℝ)<p.lossDen := by exact_mod_cast hL.1.2
    have hed : (0:ℝ)<e.den := by exact_mod_cast he.1.1.1.2
    have hx : kappa p=(e.x:ℝ)/e.den := by
      apply (div_eq_div_iff hpd.ne' hed.ne').mpr
      exact_mod_cast he.1.1.2
    have hy : lambda p=(e.y:ℝ)/e.den := by
      apply (div_eq_div_iff hpd.ne' hed.ne').mpr
      exact_mod_cast he.1.2
    have hrad : radical p≤40 := (div_le_iff₀ hld).mpr (by exact_mod_cast hL.2)
    have hcharge : (1+radical p)*θ≤1/(2*(T:ℝ)) :=
      (mul_le_mul_of_nonneg_right (by linarith only [hrad] : 1+radical p≤1000) hn).trans htheta
    left
    refine ⟨w,avoidsPoles_sound _ _ _ he.2 k (le_trans (by decide +kernel : 21≤2*F+1) hk),?_⟩
    change save≤1-lambda p-kappa p*(u-1)-(1+radical p)*θ
    rw [hx,hy]
    linarith only [hgap,hpair,hcharge]
  · have hwt : 1≤WaringEnvelope.weylWeight j := by
      unfold WaringEnvelope.weylWeight
      exact le_min (Nat.one_le_two_pow) (Nat.mul_pos (by omega) (by omega))
    have hw : (1:ℝ)≤WaringEnvelope.weylWeight j := by exact_mod_cast hwt
    have hJ : (j:ℝ)≤1000 := by exact_mod_cast hjk.trans hf
    have hJθ := (mul_le_mul_of_nonneg_right hJ hn).trans htheta
    have hθ := (mul_le_mul_of_nonneg_right (by norm_num : (1:ℝ)≤1000) hn).trans htheta
    rw [one_mul] at hθ
    have hgap' : (WaringEnvelope.weylWeight j:ℝ)*save+1/(2*(T:ℝ))
        ≤ WaringEnvelope.weylWeight j*((σ:ℝ)/T) := calc
      _ ≤ WaringEnvelope.weylWeight j*(save+1/(2*(T:ℝ))) := by
        rw [mul_add]
        exact add_le_add_left (le_mul_of_one_le_left hhalf.le hw) _
      _ ≤ _ := mul_le_mul_of_nonneg_left hgap (Nat.cast_nonneg _)
    right
    refine ⟨j,hj,hjk.trans hk,?_⟩
    simp only [WaringEnvelope.WeylAt,mul_zero,sub_zero] at hweyl ⊢
    rcases hweyl with ⟨h₁,h₂,h₃⟩
    exact ⟨by linarith only [h₁,hJθ,hgap'],by linarith only [h₂,hθ,hgap'],
      by linarith only [h₃,hJθ,hgap']⟩

/-- A single explicit sufficiently large degree works for the whole
finite limiting menu, independently of the field. -/
theorem endpoint_at_degree {z code m k : Nat} (ok : endpoint z code = some m)
    (hk : 2000*F*T≤k) {u : ℝ} (hu : 1≤u) (hm : u≤(m:ℝ)/B) :
    FiniteCovered k z ((F:ℝ)/k) u := by
  have hlo : 2*F+1≤2000*F*T := by decide +kernel
  have hpos : 0<k := lt_of_lt_of_le (by decide +kernel : 0<2000*F*T) hk
  have hr : (0:ℝ)<k := by exact_mod_cast hpos
  have hT : (0:ℝ)<T := by exact_mod_cast T_pos
  have h : 2000*(F:ℝ)*T≤k := by exact_mod_cast hk
  apply endpoint_stable ok (hlo.trans hk) (by positivity) _ hu hm
  apply (div_le_div_iff₀ hr (by positivity)).mpr
  linarith only [h]

#print axioms endpoint_stable
#print axioms endpoint_at_degree
end WaringLimit
